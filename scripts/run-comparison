#!/usr/bin/env -S uv run --quiet --with pyyaml --script
# /// script
# requires-python = ">=3.12"
# ///
"""Run an A/B as randomised blocks of single trials, only as deep as it needs.

Three problems this addresses, all of them found in this repository's own
results.

**Order.** Every comparison recorded before August 2026 ran one arm to
completion and the other hours later. A model update, a caching change or a
quiet backend migration in between arrives as a difference between arms and
cannot be told apart from one.

The fix is the trial, not the batch. A *block* is one trial of every arm, in an
order shuffled per block, and a trial is its own Harbor call and its own job
directory. Until August 2026 this alternated whole three-trial jobs and called
it interleaving; within a stage, one arm still ran back to back, so a drift
inside that stage landed on one side. Pooling across many small jobs is what
`scripts/analyze` reads, and the reason it takes an experiment rather than two
directories.

Since 31 August the arms of a block run *at the same time* rather than one
after the other. Shuffling the order was the defence against a drift landing on
one arm; running them together removes what was being defended against, because
both arms are sampled in the same minutes. It also halves the wall time, which
is the reason anybody notices. Concurrency is one block wide -- typically two
trials -- never the trial budget: five fleets at once is how a night of trials
died on the API rate limit.

**Depth.** Three trials per arm was treated as the measurement. It is not: on
the runtime case the spread inside one arm covered the gap between arms, and a
median difference got published as a 53% saving before the per-trial figures
were looked at. So a run starts at three blocks and continues only where the
result is close enough that more blocks could settle it.

**The endpoint.** `--primary` is required, and it is written into the record
before the first trial starts. With eight dimensions read per run, something
moves in most of them; choosing which one mattered afterwards turns a coin flip
into a finding. Everything else the analysis reports is labelled exploratory.

    scripts/run-comparison <case-id> --arms control,nr --primary outcome_quality --model claude-haiku-4-5-20251001
"""

from __future__ import annotations

import argparse
import concurrent.futures as cf
import json
import os
import random
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

import cases  # noqa: E402
import stats  # noqa: E402
import validity  # noqa: E402
from dimensions import ids_for  # noqa: E402
from schemas import EXPERIMENT_VERSION  # noqa: E402

# Blocks per round. Three is enough to notice a difference and never enough to
# establish one: complete separation of two groups of three happens by chance
# one time in ten — two of the twenty orderings, one per direction. The
# repository called that one in twenty until August 2026, which is the
# one-sided figure and applies only to a direction named before the data were
# seen.
ROUNDS = (3, 4, 5)

# A case's own pass/fail check, where it declares one. Not a graded dimension:
# no judge decides it, which is exactly why it may be the endpoint worth being
# powered for.
MECHANICAL = "mechanical_outcome"

# Endpoints that are not dimensions and not the mechanical outcome: what the
# trial cost and what it read.
#
# They belong here because they are measurements like any other, and because
# leaving them out made the benchmark unable to plan around its own most
# separated result. Across eleven recorded comparisons, three reached Cliff's
# delta +/-1.00 at the smallest attainable p — and all three were cost, none
# was a dimension. Every one of those was therefore exploratory by
# construction: the run could not have declared the thing it went on to find.
#
# Lower is better for both, and that is the whole difference in reading them:
# a dimension separating tells you the work changed, cost separating tells you
# the bill did.
RESOURCE = {"cost": "cost_usd", "input_tokens": "n_input_tokens"}

# Whether the arm reached for anything it was given. A rate per trial, like the
# mechanical outcome, and read from the trajectory rather than from a judge.
#
# It is declarable for the same reason cost is: it is where the benchmark's
# largest structural finding lives and could not be planned around. Six of ten
# cases on Haiku recorded zero skill invocations, and in four of those the
# matching skill was in the fleet — so a run asking "does this change make the
# capability get selected" had no endpoint to declare and could only report the
# answer as an aside.
#
# Zero is not a failure of the arm. A control arm is given nothing and cannot
# invoke; a task may genuinely need no capability. What the number answers is
# narrower and is the question: was anything reached for.
INVOCATION = "skill_invoked"


def mechanical_outcomes(jobs: list[Path], case_id: str) -> list[float]:
    """Pass/fail per valid trial, from the check the case declares itself."""
    check = cases.metadata(case_id).get("mechanical_outcome") or {}
    pattern, tokens = check.get("artifacts"), check.get("all_of")
    if not pattern or not tokens:
        return []
    outcomes = []
    for trial in gated(jobs, case_id):
        legs = sorted((trial / "artifacts" / "logs" / "artifacts").glob(pattern))
        outcomes.append(
            1.0
            if legs
            and all(
                all(token in leg.read_text(errors="ignore") for token in tokens)
                for leg in legs
            )
            else 0.0
        )
    return outcomes


def resolve_job(output: str) -> Path | None:
    """The job directory this run wrote, from its own report.

    Read from the output rather than by globbing for the newest match: a glob
    plus modification time is a race against anything else writing into
    `jobs/`, and it silently returns the wrong directory instead of failing.
    """
    match = re.search(r"snapshot written to (\S+)/nr-snapshot\.json", output)
    return Path(match.group(1)) if match else None


def run_one(case_id: str, fleet: str, env: dict, model: str | None = None) -> Path | None:
    command = [
        str(ROOT / "scripts" / "run-evaluation"),
        case_id,
        "--fleet",
        fleet,
        "--trials",
        "1",
    ]
    if model:
        command += ["--model", model]
    result = subprocess.run(command, env=env, capture_output=True, text=True)
    job = resolve_job(result.stdout)
    if result.returncode != 0 or job is None:
        print(result.stdout[-2000:], file=sys.stderr)
        print(result.stderr[-2000:], file=sys.stderr)
        return None
    return job


def gated(jobs: list[Path], case_id: str):
    for job in jobs:
        valid, _ = validity.gate(
            job,
            expected_dimensions=cases.graded_dimensions(case_id),
            required_artifacts=cases.required_artifacts(case_id),
        )
        yield from valid


def valid_trials(jobs: list[Path], case_id: str) -> int:
    return sum(1 for _ in gated(jobs, case_id))


def invocations(jobs: list[Path], case_id: str) -> list[float]:
    """1.0 per valid trial that invoked at least one skill, else 0.0."""
    out: list[float] = []
    for trial in gated(jobs, case_id):
        trajectory = validity.read_json(trial / "verifier" / "trajectory.json")
        if not isinstance(trajectory, dict):
            continue
        calls = (
            call
            for step in trajectory.get("steps") or []
            for call in (step.get("tool_calls") or [])
        )
        used = any(
            str(c.get("function_name", "")).lower() in ("skill", "invokeskill")
            for c in calls
        )
        out.append(1.0 if used else 0.0)
    return out


def resources(jobs: list[Path], case_id: str, field: str) -> list[float]:
    """What the valid trials cost, or how much they read."""
    out: list[float] = []
    for trial in gated(jobs, case_id):
        result = validity.read_json(trial / "result.json") or {}
        value = (result.get("agent_result") or {}).get(field)
        if value is not None:
            out.append(float(value))
    return out


def scores(jobs: list[Path], case_id: str) -> dict[str, list[float]]:
    """Per-dimension scores of the valid trials only."""
    out: dict[str, list[float]] = {}
    for trial in gated(jobs, case_id):
        reward = validity.read_json(trial / "verifier" / "reward.json")
        if reward is None:
            result = validity.read_json(trial / "result.json") or {}
            reward = (result.get("verifier_result") or {}).get("rewards") or {}
        for dimension, value in (reward or {}).items():
            out.setdefault(dimension, []).append(value)
    return out


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("case_id")
    parser.add_argument("--arms", required=True, help="comma-separated fleets")
    parser.add_argument(
        "--primary",
        required=True,
        help="the one endpoint this run is powered for, declared before it starts",
    )
    parser.add_argument(
        "--model",
        required=True,
        help="the agent's model for every arm; the judge stays pinned in the "
             "rubric. Held constant across arms — a model comparison is a "
             "different experiment, run through scripts/compare --variable model. "
             "Required, and required here rather than inherited: run-evaluation's "
             "default is the largest model, so an omitted flag spends roughly "
             "forty times a small-model run and says nothing while doing it",
    )
    parser.add_argument("--max-trials", type=int, default=12)
    parser.add_argument("--seed", type=int, default=None,
                        help="fix the block order, for reproduction")
    parser.add_argument("--dry-run", action="store_true",
                        help="write the plan and stop, without spending a trial")
    args = parser.parse_args()

    # `--model ""` satisfies argparse and then fails open: run_one omits the
    # flag for a falsy value, run-evaluation falls back to its own default, and
    # the record stores an empty string. That is the defect the flag was made
    # required to close, reachable by passing it.
    args.model = args.model.strip()
    if not args.model:
        parser.error("--model must name a model, not an empty string")

    arms = [a.strip() for a in args.arms.split(",") if a.strip()]
    if len(arms) < 2:
        sys.exit("--arms needs at least two fleets")

    graded = cases.graded_dimensions(args.case_id)
    if not graded:
        sys.exit(f"no case {args.case_id!r}")

    # A case that decides its own ground truth may be powered for that instead
    # of for a judged dimension, and normally should be: on the upgrade case
    # the matrix outcome reproduced across two independent runs while the
    # dimension that separated once did not.
    has_ground_truth = bool(cases.metadata(args.case_id).get("mechanical_outcome"))
    allowed = graded | set(RESOURCE) | {INVOCATION} | (
        {MECHANICAL} if has_ground_truth else set()
    )
    if args.primary not in allowed:
        sys.exit(
            f"--primary {args.primary!r} is not available for {args.case_id}, "
            f"which offers {sorted(allowed)}. An endpoint the case cannot "
            f"produce is not a plan."
        )

    seed = args.seed if args.seed is not None else random.randrange(1_000_000)
    rng = random.Random(seed)
    env = dict(os.environ)
    if not args.dry_run and not (
        env.get("CLAUDE_CODE_OAUTH_TOKEN") or env.get("ANTHROPIC_API_KEY")
    ):
        sys.exit("no credential; see scripts/run-evaluation")

    experiments = ROOT / "experiments"
    experiments.mkdir(exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    log = experiments / f"{args.case_id}-{stamp}.json"

    collected: dict[str, list[Path]] = {arm: [] for arm in arms}
    record: dict = {
        "schema_version": EXPERIMENT_VERSION,
        "experiment_id": f"{args.case_id}-{stamp}",
        "case": args.case_id,
        "arms": arms,
        # Declared here, before a single trial runs, and written to disk
        # immediately. An endpoint chosen after the data are in is not a test.
        "primary_endpoint": args.primary,
        "secondary_endpoints": sorted(graded - {args.primary}),
        # Recorded so a reader of the record knows which kind of endpoint was
        # declared without inferring it from the name.
        "primary_kind": (
            "invocation" if args.primary == INVOCATION
            else "resource" if args.primary in RESOURCE
            else "mechanical" if args.primary == MECHANICAL
            else "dimension"
        ),
        # A result that does not name the model it was produced by cannot be
        # read a year later. This once recorded the string "run-evaluation
        # default" when the flag was omitted -- a record that states the
        # requirement in its own comment and then does not meet it. The flag is
        # required now, so the value is always the model itself.
        "model": args.model,
        "randomization": "one trial per arm per block, order shuffled per block",
        "randomization_seed": seed,
        "stopping_rule": (
            f"rounds of {ROUNDS} blocks; stop after the discovery round unless "
            f"the primary endpoint separates completely, and never exceed "
            f"{args.max_trials} trials in total"
        ),
        "max_trials": args.max_trials,
        "started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "blocks": [],
        "stop_reason": "not started",
        "trials_spent": 0,
        "jobs": {arm: [] for arm in arms},
    }

    def save() -> None:
        record["jobs"] = {
            arm: [str(job.relative_to(ROOT)) for job in jobs]
            for arm, jobs in collected.items()
        }
        log.write_text(json.dumps(record, indent=2))

    save()
    print(f"experiment {record['experiment_id']}")
    print(f"  primary   {args.primary}")
    print(f"  seed      {seed}")
    print(f"  plan      {log.relative_to(ROOT)}")
    if args.dry_run:
        record["stop_reason"] = "dry run"
        save()
        print("\ndry run: the plan is on disk and no trial was spent.")
        return 0

    spent = 0
    stopped = False
    for round_number, blocks in enumerate(ROUNDS, start=1):
        if stopped:
            break
        for block in range(blocks):
            if spent + len(arms) > args.max_trials:
                record["stop_reason"] = (
                    f"budget exhausted at {spent} of {args.max_trials} trials"
                )
                stopped = True
                break

            order = list(arms)
            rng.shuffle(order)
            entry = {"round": round_number, "block": block + 1, "order": order,
                     "concurrent": True, "jobs": {}}
            print(f"\nround {round_number} block {block + 1}: {' '.join(order)}")
            # The arms of a block run at the same time, not one after another.
            # Shuffling the order was the defence against drift landing on one
            # arm; running them together removes the thing being defended
            # against, because both arms are sampled in the same minutes. The
            # shuffle stays for the arms' position in the printed record and
            # for any effect of starting a container first.
            #
            # A block, not the whole run: concurrency stays at the number of
            # arms, typically two. The 19 August jobs died as ApiRateLimitError
            # across five fleets at once (instrument failure 29), and one trial
            # asks for 4 CPUs and 8 GB.
            with cf.ThreadPoolExecutor(max_workers=len(order)) as pool:
                started = {
                    fleet: pool.submit(run_one, args.case_id, fleet, env, args.model)
                    for fleet in order
                }
                results = {fleet: f.result() for fleet, f in started.items()}
            for fleet in order:
                job = results[fleet]
                if job is None:
                    # Fail closed. Continuing leaves the arms unequal for a
                    # reason that is not the treatment, and nothing downstream
                    # would say so.
                    record["stop_reason"] = (
                        f"arm {fleet} failed in round {round_number} "
                        f"block {block + 1}"
                    )
                    record["blocks"].append(entry)
                    record["trials_spent"] = spent
                    save()
                    print(f"\n{record['stop_reason']}; stopping rather than "
                          f"comparing unequal arms.", file=sys.stderr)
                    return 1
                collected[fleet].append(job)
                entry["jobs"][fleet] = str(job.relative_to(ROOT))
                spent += 1
                print(f"  {fleet}: {job.name}")
            record["blocks"].append(entry)
            record["trials_spent"] = spent
            save()

        if stopped or round_number > 1:
            continue

        # After the discovery round: continue only if something is happening on
        # the endpoint this run was planned around. A dimension that moves
        # elsewhere is exploratory and is not worth more trials on its own —
        # eight looks at a one-in-ten event separate somewhere in most runs.
        first, second = arms[0], arms[1]
        if args.primary == MECHANICAL:
            # Pass/fail, so complete separation is the wrong test: [0,1,1]
            # against [1,1,1] can never separate, and that difference is
            # exactly the finding. Any gap in the rate is worth more trials,
            # because it is the one number no judge decided.
            primary_a = mechanical_outcomes(collected[first], args.case_id)
            primary_b = mechanical_outcomes(collected[second], args.case_id)
            p = stats.fisher_p(
                int(sum(primary_a)), len(primary_a),
                int(sum(primary_b)), len(primary_b),
            )
            moved = bool(primary_a) and bool(primary_b) and (
                sum(primary_a) / len(primary_a) != sum(primary_b) / len(primary_b)
            )
            summary = (
                f"{sum(primary_a):.0f}/{len(primary_a)} against "
                f"{sum(primary_b):.0f}/{len(primary_b)}"
            )
        elif args.primary == INVOCATION:
            # A rate, so tested as the mechanical outcome is: [0,0,0] against
            # [3,3,3] can never "separate completely" in the sense a score can,
            # and that difference is the entire finding.
            primary_a = invocations(collected[first], args.case_id)
            primary_b = invocations(collected[second], args.case_id)
            p = stats.fisher_p(
                int(sum(primary_a)), len(primary_a),
                int(sum(primary_b)), len(primary_b),
            )
            moved = bool(primary_a) and bool(primary_b) and (
                sum(primary_a) / len(primary_a) != sum(primary_b) / len(primary_b)
            )
            summary = (
                f"{sum(primary_a):.0f}/{len(primary_a)} against "
                f"{sum(primary_b):.0f}/{len(primary_b)}"
            )
        elif args.primary in RESOURCE:
            # Same test as a dimension — complete separation, exact permutation
            # — because the question is the same: is anything obviously
            # happening. What differs is only which number is being read.
            field = RESOURCE[args.primary]
            primary_a = resources(collected[first], args.case_id, field)
            primary_b = resources(collected[second], args.case_id, field)
            p, _ = stats.permutation_p(primary_a, primary_b)
            moved = stats.separated(primary_a, primary_b)
            summary = "separates completely" if moved else "overlaps"
        else:
            primary_a = scores(collected[first], args.case_id).get(args.primary, [])
            primary_b = scores(collected[second], args.case_id).get(args.primary, [])
            p, _ = stats.permutation_p(primary_a, primary_b)
            moved = stats.separated(primary_a, primary_b)
            summary = "separates completely" if moved else "overlaps"

        record["blocks"][-1]["primary_p"] = p
        if moved:
            print(f"\n{args.primary}: {summary} (p {p:.3f}) — continuing")
        else:
            record["stop_reason"] = (
                f"{args.primary} did not move after the discovery round "
                f"({summary}, p {p:.3f})"
            )
            print(f"\n{record['stop_reason']}; stopping.")
            print("Three trials per arm cannot establish a difference, and "
                  "nothing here suggests one is there to establish.")
            stopped = True

    if record["stop_reason"] == "not started":
        record["stop_reason"] = "rounds exhausted"
    record["finished_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    record["valid_trials"] = {
        arm: valid_trials(jobs, args.case_id) for arm, jobs in collected.items()
    }
    save()

    print(f"\nstopped: {record['stop_reason']}")
    print(f"trials:  {spent}")
    for arm, jobs in collected.items():
        print(f"  {arm}: {len(jobs)} job(s), "
              f"{record['valid_trials'][arm]} valid trial(s)")
    print(f"\nscripts/analyze {log.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
