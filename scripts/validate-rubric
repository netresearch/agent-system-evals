#!/usr/bin/env -S uv run --quiet --with harbor-rewardkit==0.1.7 --script
# Upper bound on purpose: RewardKit's pydantic calls a typing internal that
# Python 3.14 removed, and an unbounded floor silently selects it.
# /// script
# requires-python = ">=3.12,<3.14"
# ///
"""Validate every case's rubric without calling a judge.

RewardKit only reports a malformed rubric when it runs, and running it costs a
judge call per criterion. Discovery builds the same objects and calls nothing,
so a broken TOML key, an unparseable criterion or a missing prompt template
surfaces in CI for free.

Also enforces the repository's own rules about rubric shape, which RewardKit
has no reason to know:

- every dimension is defined in dimensions.toml
- the copy of that registry inside datasets/*/metric.py has not drifted
- qualitative criteria are three-point, so PARTIAL is reachable
- every judge is pinned to a named model
- every judge uses the shared anti-bias prompt template
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

from rewardkit.runner import discover

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from dimensions import all_ids, ids_for, met_threshold  # noqa: E402

DIMENSIONS = set(ids_for("open"))


def check_metric_copies() -> list[str]:
    """The dataset metric carries a literal copy of the registry. Is it current?

    It has to be literal: the dataset manifest publishes `metric.py` as a
    standalone file, so it cannot read `dimensions.toml`. The copy is the reason
    the metric aggregated `skill_routing` for weeks after the dimension was
    renamed — it named a dimension no case emits and ignored the one every case
    does, and the CI smoke test fed it the old name too, so the run stayed
    green. This is the gate that would have caught it.
    """
    problems = []
    expected = all_ids()
    for path in sorted(ROOT.glob("datasets/*/metric.py")):
        block = re.search(
            r"# BEGIN GENERATED: dimensions\.toml(.*?)# END GENERATED",
            path.read_text(),
            re.S,
        )
        if not block:
            problems.append(
                f"{path.relative_to(ROOT)}: no generated block; it must carry a "
                f"copy of dimensions.toml between the BEGIN/END markers"
            )
            continue
        found = re.findall(r'"([a-z_]+)"', block.group(1))
        if found != expected:
            problems.append(
                f"{path.relative_to(ROOT)}: dimension copy is stale — has "
                f"{found}, dimensions.toml says {expected}"
            )
        threshold = re.search(r"^MET = ([0-9.]+)", block.group(1), re.M)
        if not threshold or float(threshold.group(1)) != met_threshold():
            problems.append(
                f"{path.relative_to(ROOT)}: MET is {threshold and threshold.group(1)}, "
                f"dimensions.toml says {met_threshold()}"
            )
    return problems


def main() -> int:
    problems: list[str] = check_metric_copies()
    checked = 0

    for tests_dir in sorted(ROOT.glob("tasks/*/*/tests")):
        case = tests_dir.parent.name
        config = tests_dir.parent / "task.toml"
        contract = config.is_file() and "contract = true" in config.read_text()
        subdirs = {
            d.name
            for d in tests_dir.iterdir()
            if d.is_dir() and not d.name.startswith((".", "__"))
        }

        # A contract eval is graded pass/fail on a named condition and has no
        # eight-dimension rubric to satisfy (ADR 0002). Demanding one would be
        # demanding that it be an open review.
        # A case may grade fewer dimensions than the full eight, and must say
        # so in its own metadata. The eight exist for an open review; a
        # low-level maintenance task does not have eight things worth judging,
        # and forcing them makes it expensive enough to stop being low-level.
        #
        # Declared rather than inferred from the directory listing: two cases
        # graded on different subsets can be compared by mistake, and a
        # declaration is what a reader and a script can both check.
        declared = None
        if config.is_file():
            import tomllib

            meta = tomllib.loads(config.read_text()).get("metadata", {})
            if meta.get("dimensions"):
                declared = set(meta["dimensions"])
                # Against the registry, not against a set literal plus a
                # hand-maintained exception list. `consistency` was allowed
                # here by exception while the comparator and the metric had
                # never heard of it, so two cases graded a dimension nothing
                # downstream could report.
                unknown_declared = declared - set(all_ids())
                if unknown_declared:
                    problems.append(
                        f"{case}: metadata.dimensions names {sorted(unknown_declared)}, "
                        f"which dimensions.toml does not define"
                    )

        expected = {"contract"} if contract else (declared or DIMENSIONS)
        unknown = subdirs - expected
        if unknown:
            problems.append(
                f"{case}: unknown reward dimension(s) {sorted(unknown)}; "
                f"see docs/scoring.md"
            )
        missing = expected - subdirs
        if missing:
            problems.append(f"{case}: missing dimension(s) {sorted(missing)}")

        try:
            rewards = discover(tests_dir, workspace=ROOT)
        except Exception as exc:  # noqa: BLE001 - report, do not crash the run
            problems.append(f"{case}: rubric failed to load: {exc}")
            continue

        for reward in rewards:
            checked += 1
            judge = getattr(reward, "judge", None)
            if judge is None:
                continue  # a programmatic-only reward has no judge to check

            model = getattr(judge, "model", None) or getattr(judge, "agent", None)
            if not model:
                problems.append(f"{case}/{reward.name}: judge has no pinned model")

            # An agent judge never sees `files`. RewardKit's agent path builds
            # its prompt, appends the atif-trajectory path, and ignores the
            # file list entirely — so evidence placed only in `files` reaches
            # nobody. That happened: the judges were left with no pointer to
            # anything, explored blindly, and every dimension collapsed across
            # every fleet. The numbers looked like a finding.
            is_agent = getattr(judge, "agent", None) is not None
            if is_agent and not getattr(judge, "atif_trajectory", None):
                problems.append(
                    f"{case}/{reward.name}: an agent judge with no "
                    f"atif-trajectory has no pointer to any evidence — `files` "
                    f"is ignored on the agent path"
                )

            if not getattr(reward, "system_prompt", None):
                problems.append(
                    f"{case}/{reward.name}: no prompt_template; the shared "
                    f"anti-bias framing in tests/judge-prompt.md is mandatory"
                )

            for criterion in reward.criteria:
                points = getattr(criterion.output_format, "points", None)
                if points is None:
                    continue  # binary mechanical criterion
                if points != 3:
                    problems.append(
                        f"{case}/{reward.name}/{criterion.name}: "
                        f"{points}-point scale; the rubric is three-point so "
                        f"PARTIAL stays reachable (docs/scoring.md)"
                    )

    if problems:
        print(f"{len(problems)} problem(s):", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        return 1

    print(f"rubric valid: {checked} reward(s) across all cases")
    return 0


if __name__ == "__main__":
    sys.exit(main())
