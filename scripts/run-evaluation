#!/usr/bin/env -S uv run --quiet --with pyyaml --script
# /// script
# requires-python = ">=3.12"
# ///
"""Run one case against one fleet, with everything else held constant.

The whole value of an A/B rests on nothing else moving between the two runs, so
the fleet is the only thing this script takes from a manifest. Agent, model and
trial count are explicit arguments with recorded defaults; the judge comes from
the rubric, which is where it is versioned. All of them are written into the
snapshot alongside the result.

    scripts/run-evaluation OFR-TYPO3-EXT-001 --fleet main
    scripts/run-evaluation OFR-TYPO3-EXT-001 --fleet candidate
    scripts/compare <job-a> <job-b>
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]

# Recorded defaults. Overridable, but a change to any of them means results are
# not comparable with earlier ones — see docs/reproducibility.md.
DEFAULT_AGENT = "claude-code"
DEFAULT_MODEL = "claude-opus-5"
DEFAULT_TRIALS = 3


def find_case(case_id: str) -> Path:
    """Locate a case by its identifier rather than its path.

    Cases are addressed by identifier everywhere else — in retro exports, in
    the dashboard, in conversation — so the directory layout stays free to
    change without breaking every reference to a result.
    """
    matches = []
    for config_path in ROOT.glob("tasks/*/*/task.toml"):
        config = tomllib.loads(config_path.read_text())
        if config.get("metadata", {}).get("case_id") == case_id:
            matches.append(config_path.parent)

    if not matches:
        known = sorted(
            tomllib.loads(p.read_text()).get("metadata", {}).get("case_id", "?")
            for p in ROOT.glob("tasks/*/*/task.toml")
        )
        sys.exit(f"no case {case_id!r}; known cases: {', '.join(known)}")
    if len(matches) > 1:
        sys.exit(f"case id {case_id!r} is used by more than one task: {matches}")
    return matches[0]


def rubric_judge(case_dir: Path) -> str:
    """The judge the case's rubric pins, read from its judge.toml files.

    Recorded rather than chosen at the command line: a result has to be able to
    say what judged it, and the rubric is where that is versioned.
    """
    judges = set()
    for path in sorted(case_dir.glob("tests/*/judge.toml")):
        config = tomllib.loads(path.read_text())
        name = config.get("judge", {}).get("judge")
        if name:
            judges.add(name)

    if not judges:
        sys.exit(f"{case_dir}: no judge pinned in any tests/*/judge.toml")
    if len(judges) > 1:
        # Different judges across dimensions would make the vector
        # incomparable with itself, never mind across runs.
        sys.exit(
            f"{case_dir}: dimensions pin different judges ({sorted(judges)}); "
            f"one case is graded by one judge"
        )
    return judges.pop()


def load_fleet(name: str) -> list[str]:
    path = ROOT / "fleets" / f"{name}.yaml"
    if not path.exists():
        available = sorted(p.stem for p in (ROOT / "fleets").glob("*.yaml"))
        sys.exit(f"no fleet {name!r}; available: {', '.join(available)}")

    fleet = yaml.safe_load(path.read_text()) or {}
    entries = []
    for skill in fleet.get("skills") or []:
        ref = skill.get("ref")
        if not ref:
            sys.exit(f"{path}: skill {skill.get('repo')} has no ref; pin it")
        # A full commit SHA cannot be used: Harbor resolves the ref with
        # `git ls-remote <url> <ref>`, which returns nothing for a bare SHA and
        # fails with "No matching ref". Tags and branches work; the resolved
        # SHA is recovered afterwards from the job lock.
        if len(ref) == 40 and all(c in "0123456789abcdef" for c in ref.lower()):
            sys.exit(
                f"{path}: skill {skill['repo']} is pinned to a commit SHA. "
                f"Harbor resolves refs via git ls-remote, which cannot answer "
                f"for a bare SHA. Use a tag."
            )
        entries.append(f"{skill['repo']}@{ref}")
    return entries


def load_companion(name: str) -> tuple[Path, Path] | None:
    """Materialise the fleet's TYPO3 Dev Companion, if it declares one.

    Returns (skills directory, MCP config), both local paths.

    The companion arrives by two routes rather than one. Its skills cannot be
    injected from git: each opens on a references/base.md that only its
    installer writes, so scripts/prepare-companion runs that installer and this
    passes the published result as a local path. Its server is a PHP process
    launched over stdio and lives in the environment image; only the config
    that registers it varies per fleet.
    """
    fleet = yaml.safe_load((ROOT / "fleets" / f"{name}.yaml").read_text()) or {}
    companion = fleet.get("companion")
    if not companion:
        return None

    ref = companion.get("ref")
    if not ref:
        sys.exit(f"fleets/{name}.yaml: companion has no ref; pin a commit")

    cache = ROOT / ".cache" / "companion" / ref
    if not (cache / "skills").is_dir() or not (cache / "mcp.json").is_file():
        print(f"materialising companion {ref[:12]}")
        result = subprocess.run(
            [str(ROOT / "scripts" / "prepare-companion"), ref],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            sys.exit(
                f"could not materialise the companion:\n{result.stdout}{result.stderr}"
            )

    return cache / "skills", cache / "mcp.json"


def load_mcp_server(name: str) -> tuple[str, Path] | None:
    """An MCP server that lives in the environment image, if the fleet has one.

    Returns (server name, written config). Unlike the companion there is
    nothing to materialise: the server is a console command of the instance
    under test, installed into the image for every fleet so that only this
    config varies between arms.
    """
    fleet = yaml.safe_load((ROOT / "fleets" / f"{name}.yaml").read_text()) or {}
    server = fleet.get("mcp")
    if not server:
        return None

    for key in ("name", "command"):
        if not server.get(key):
            sys.exit(f"fleets/{name}.yaml: mcp has no {key}")

    config = {
        "mcpServers": {
            server["name"]: {
                "type": "stdio",
                "command": server["command"],
                "args": list(server.get("args") or []),
            }
        }
    }
    path = ROOT / ".cache" / "mcp" / f"{name}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=4) + "\n")
    return server["name"], path


def mcp_was_reached(job_dir: Path, server: str) -> tuple[int, int]:
    """How many recorded trials actually called a tool of *server*.

    The companion's own skills stop on the first turn when its server is not
    answering — "no tool in this session … stop, say this workflow needs the
    server and it is not there". A mis-installed server therefore produces
    trials that look like a catastrophically bad tool rather than like a broken
    harness, and nothing downstream can tell the two apart.

    So this counts them. It is a validity check, not a score: a fleet that was
    never active did not lose, it did not run.

    Matched on the client's own prefix, `mcp__<server>__`, rather than on a
    guess at the tool names. Guessing was tried: `typo3_` matches the
    companion's tools and none of typo3-dev-mcp's, which are `site_info`,
    `database_query` and the like behind a hyphenated server name — so the
    check would have reported a working arm as never reached.
    """
    prefix = f"mcp__{server}__"
    reached = 0
    total = 0
    # One trajectory per trial, at the trial's own `agent/` path. A recursive
    # glob counts each trial twice: Harbor writes the file once there and again
    # under `artifacts/logs/agent/`, so this reported "4 of 6" for a job of
    # three trials — a ratio that cannot occur, printed as a warning about the
    # tool rather than about the counter.
    for trial_dir in sorted(p for p in job_dir.iterdir() if p.is_dir()):
        path = trial_dir / "agent" / "trajectory.json"
        if not path.is_file():
            continue
        total += 1
        try:
            trajectory = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        calls = (
            call.get("function_name", "")
            for step in trajectory.get("steps", [])
            for call in (step.get("tool_calls") or [])
        )
        if any(name.startswith(prefix) for name in calls):
            reached += 1
    return reached, total


# A trial of this benchmark takes minutes and a fleet takes hours, while a
# subscription token is valid for a couple of hours and is *revoked* the moment
# Claude Code refreshes it. A run started with a token near the end of its life
# therefore dies partway through with
# `401 OAuth access token has been revoked` — and dies per trial, so the job
# still reports a mixture of completed and errored trials rather than failing
# outright. That mixture is the dangerous part: three graded trials beside
# three dead ones look like a fleet that scored worse, not like a run that lost
# its credential halfway.
#
# So the check is up front, where a warning still costs nothing.
CREDENTIALS = Path.home() / ".claude" / ".credentials.json"
# Generous: an agent trial plus up to four batches of judges at 900s each.
MINUTES_PER_TRIAL = 25


def token_expiry(token: str) -> datetime | None:
    """When the running Claude Code session's token expires, if that is knowable."""
    try:
        stored = json.loads(CREDENTIALS.read_text())["claudeAiOauth"]
    except (OSError, KeyError, json.JSONDecodeError):
        return None
    # Only meaningful if the caller passed the very token this file describes;
    # a token from `claude setup-token` is long-lived and unrelated.
    if stored.get("accessToken") != token or not stored.get("expiresAt"):
        return None
    return datetime.fromtimestamp(stored["expiresAt"] / 1000, tz=timezone.utc)


def check_token_outlives_the_run(token: str, args: argparse.Namespace) -> None:
    expiry = token_expiry(token)
    if expiry is None:
        return

    remaining = (expiry - datetime.now(timezone.utc)).total_seconds() / 60
    needed = args.trials * MINUTES_PER_TRIAL
    if remaining >= needed:
        return

    message = (
        f"The session token expires in {remaining:.0f} min; "
        f"{args.trials} trials need roughly {needed} min. It is revoked on "
        "refresh, so trials past that point fail with a 401 and the job "
        "reports them as errored trials rather than as a credential problem.\n"
        "Re-read the token, or run fewer trials per invocation."
    )
    if args.dry_run:
        print(f"warning: {message}", file=sys.stderr)
        return
    sys.exit(message)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("case_id")
    parser.add_argument("--fleet", default="main")
    parser.add_argument("--trials", type=int, default=DEFAULT_TRIALS)
    parser.add_argument("--agent", default=DEFAULT_AGENT)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    # No --judge flag. The judge is a property of the rubric, pinned in each
    # judge.toml and covered by the rubric digest. An environment override
    # would leave a recorded result unable to say what judged it.
    parser.add_argument("--jobs-dir", default=str(ROOT / "jobs"))
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the resolved command without running it",
    )
    args = parser.parse_args()

    case_dir = find_case(args.case_id)
    skills = load_fleet(args.fleet)
    companion = load_companion(args.fleet)
    mcp_server = load_mcp_server(args.fleet)
    if companion and mcp_server:
        sys.exit(
            f"fleets/{args.fleet}.yaml declares both a companion and an mcp "
            f"server, and Harbor accepts a single --mcp-config. Merging the "
            f"two configs is not implemented; a combined arm needs it."
        )
    judge = rubric_judge(case_dir)

    # Either credential works, for the agent and for the judge alike. The
    # subscription token is the cheaper path: LiteLLM sends an sk-ant-oat token
    # as a bearer token, so RewardKit judges on the subscription too rather
    # than billing an API key.
    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    oauth_token = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN", "")
    if not api_key and not oauth_token:
        sys.exit(
            "No credential. Set CLAUDE_CODE_OAUTH_TOKEN (from `claude "
            "setup-token`, covered by a Claude subscription) or "
            "ANTHROPIC_API_KEY (billed per token). Both the agent and the "
            "verifier's judge use whichever is present."
        )

    check_token_outlives_the_run(oauth_token, args)

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    job_name = f"{args.case_id}-{args.fleet}-{stamp}"

    # `-p` is a *dataset* path, not a task path: Harbor resolves it to
    # datasets[].path and then looks for task directories inside it. Pointed
    # straight at a task directory it finds none and fails with "Either
    # datasets or tasks must be provided", which does not describe the
    # mistake. So: parent directory, plus a name filter to select the one case.
    # The filter matches the task *directory* name, not [task].name from
    # task.toml. Harbor's own error prints the available names, which is how
    # this was settled.
    short_name = case_dir.name

    command = [
        "harbor",
        "run",
        "-p",
        str(case_dir.parent),
        "-i",
        short_name,
        "-a",
        args.agent,
        "-m",
        args.model,
        "-k",
        str(args.trials),
        "--job-name",
        job_name,
        "-o",
        args.jobs_dir,
        "--yes",
        # Harbor retries nothing by default, and a trial that dies on a
        # transient API fault is not dropped — it is kept, scored zero, and
        # averaged into the fleet's metrics. One such trial pulled a companion
        # arm down to means of 0.2–0.3, which reads as a catastrophically bad
        # tool rather than as a lost credential.
        #
        # Only transport faults are retried. An environment failure, a missing
        # reward file or a broken rubric must surface as itself; retrying those
        # would hide a defect in the case behind a second attempt.
        "--max-retries",
        "2",
        "--retry-include",
        "ApiRateLimitError",
        "--retry-include",
        "UnknownApiError",
    ]
    for skill in skills:
        command += ["--skill", skill]
    if companion:
        skills_dir, mcp_config = companion
        command += ["--skill", str(skills_dir), "--mcp-config", str(mcp_config)]
    if mcp_server:
        command += ["--mcp-config", str(mcp_server[1])]

    using_subscription = bool(oauth_token) and not api_key

    print(f"case    {args.case_id}  ({case_dir.relative_to(ROOT)})")
    companion_note = ""
    if companion:
        published = len([p for p in companion[0].iterdir() if p.is_dir()])
        companion_note = f" + companion ({published} skill(s) and its MCP server)"
    if mcp_server:
        companion_note = f" + {mcp_server[0]} (MCP server, no skills)"
    print(f"fleet   {args.fleet}  ({len(skills)} skill(s)){companion_note}")
    print(f"agent   {args.agent} / {args.model}")
    print(f"judge   {judge}  (pinned in the rubric)")
    print(f"trials  {args.trials}")
    print(f"auth    {'subscription (OAuth)' if using_subscription else 'API key'}")
    print()

    if args.dry_run:
        print(" ".join(command))
        return 0

    # Harbor refuses to start when a variable named in [verifier.env] is unset,
    # and TOML cannot declare one credential or the other conditionally. So the
    # unused one is passed as an empty string, which both RewardKit and the
    # Claude Code CLI treat as absent.
    env = dict(
        os.environ,

        ANTHROPIC_API_KEY=api_key,
        CLAUDE_CODE_OAUTH_TOKEN=oauth_token,
    )

    # Harbor scrubs every [verifier.env] value from captured output, so a short
    # value corrupts the artifacts wholesale — a flag passed as "1" replaced
    # every digit 1 in every collected file, including the evidence manifest,
    # whose escaped em dash became `\u20[REDACTED]4` and stopped being JSON.
    # Values are only knowable here, at run time, which is why the check lives
    # here rather than in validate-tasks.
    verifier_env = tomllib.loads((case_dir / "task.toml").read_text()).get(
        "verifier", {}
    ).get("env", {})
    for name, template in verifier_env.items():
        value = env.get(name.strip(), "")
        if value and len(value) < 12:
            sys.exit(
                f"{name} is declared in [verifier.env] with a {len(value)}-character "
                f"value. Harbor removes that string from every captured file, so a "
                f"short value corrupts the artifacts. Pass flags through the "
                f"process environment instead of declaring them here."
            )

    result = subprocess.run(command, env=env)

    job_dir = Path(args.jobs_dir) / job_name
    if job_dir.exists():
        snapshot = {
            "case_id": args.case_id,
            "fleet": args.fleet,
            "fleet_requested": skills,
            "companion": (
                {"path": str(companion[0]), "mcp": str(companion[1])}
                if companion
                else None
            ),
            "mcp_server": mcp_server[0] if mcp_server else None,
            "agent": args.agent,
            "model": args.model,
            "judge": judge,
            "trials": args.trials,
            "recorded_at": stamp,
            # Requested versions only. The resolved skill commits, task digest
            # and environment image digest live in Harbor's job lock;
            # scripts/snapshot reads them from there, because a manifest states
            # intent and only the lock states fact.
            "provenance_source": "harbor job lock",
        }
        if companion:
            reached, total = mcp_was_reached(job_dir, "typo3-dev-companion")
            snapshot["companion_reached_in_trials"] = f"{reached}/{total}"
            if total and reached == 0:
                print(
                    f"\nWARNING: no trial called a companion tool. Its skills stop "
                    f"on the first turn when the server does not answer, so these "
                    f"{total} trial(s) measure a broken installation, not the "
                    f"companion. Do not report them as a result.",
                    file=sys.stderr,
                )
            elif reached < total:
                print(
                    f"\nWARNING: the companion answered in only {reached} of "
                    f"{total} trial(s); the rest are not comparable with them.",
                    file=sys.stderr,
                )

        if mcp_server:
            reached, total = mcp_was_reached(job_dir, mcp_server[0])
            snapshot["mcp_reached_in_trials"] = f"{reached}/{total}"
            if total and reached == 0:
                print(
                    f"\nWARNING: no trial called a tool of {mcp_server[0]}. This "
                    f"fleet is nothing but that server, so these {total} trial(s) "
                    f"are indistinguishable from a control run. Do not report "
                    f"them as a result for this arm.",
                    file=sys.stderr,
                )
            elif reached < total:
                print(
                    f"\nWARNING: {mcp_server[0]} answered in only {reached} of "
                    f"{total} trial(s); the rest are not comparable with them.",
                    file=sys.stderr,
                )

        (job_dir / "nr-snapshot.json").write_text(json.dumps(snapshot, indent=2))
        print(f"\nsnapshot written to {job_dir / 'nr-snapshot.json'}")

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
