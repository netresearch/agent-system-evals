#!/usr/bin/env bash
# Re-score a recorded job with the current rubric, keeping its provenance.
#
# `harbor job regrade` writes a new job directory and does not carry over the
# snapshot this repository writes beside a run. Without it the regraded job
# cannot say which fleet, agent or model produced the trials it re-scored, and
# scripts/compare refuses it — correctly, because a comparison whose
# configuration is unknown is not interpretable.
#
# Regrading costs judge calls and no agent time, which is what makes a rubric
# fix affordable: raise a timeout, re-score the history, keep the trials.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE="${1:?usage: regrade <job-dir> [case-dir]}"
SOURCE="$(cd "$SOURCE" && pwd)"
CASE="${2:-}"

if [ -z "$CASE" ]; then
    case_id="$(python3 -c "
import json, sys
print(json.load(open('$SOURCE/nr-snapshot.json'))['case_id'])" 2>/dev/null || true)"
    [ -n "$case_id" ] || { echo "no case_id in $SOURCE/nr-snapshot.json; pass the case directory" >&2; exit 1; }
    CASE="$(python3 -c "
import tomllib, pathlib, sys
for p in pathlib.Path('$ROOT/tasks').glob('*/*/task.toml'):
    if tomllib.loads(p.read_text()).get('metadata', {}).get('case_id') == '$case_id':
        print(p.parent); break
")"
    [ -n "$CASE" ] || { echo "no case directory for $case_id" >&2; exit 1; }
fi

name="rg-$(basename "$SOURCE")"
rm -rf "${ROOT:?}/jobs/$name"

# Both credentials must exist as variables even when only one holds a value.
# `[verifier.env]` names both, Harbor resolves every name it finds there
# against the host environment, and an unset one aborts the run with
# `Environment variable 'ANTHROPIC_API_KEY' not found in host environment` —
# after the verifier image has been built, so the failure looks like a grading
# problem rather than a missing export. run-evaluation passes the unused one as
# an empty string, which RewardKit and the Claude Code CLI read as absent; a
# regrade re-runs the same verifier and needs the same treatment.
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    echo "No credential: set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY." >&2
    exit 1
fi

harbor job regrade "$SOURCE" -p "$CASE" -o "$ROOT/jobs" --job-name "$name"

if [ -f "$SOURCE/nr-snapshot.json" ]; then
    python3 - "$SOURCE/nr-snapshot.json" "$ROOT/jobs/$name/nr-snapshot.json" \
             "$CASE" "$ROOT" <<'PY'
import hashlib, json, pathlib, sys
from datetime import datetime, timezone

snapshot = json.load(open(sys.argv[1]))
case, root = pathlib.Path(sys.argv[3]), pathlib.Path(sys.argv[4])

# Marked, so a regraded result is never mistaken for a fresh run: the trials
# are the originals, only the scoring is new.
snapshot["regraded_from"] = sys.argv[1].rsplit("/", 2)[-2]

# The grade is replaced; the trial fingerprint is not. Copying the whole
# snapshot forward — which is all this did — left a job re-scored with today's
# rubric carrying the identity of the rubric that scored it months ago, and
# scripts/compare then read the two as having been graded alike. What was run
# has not changed. How it was judged has, and only this block says so.
tests = case / "tests"
digest = hashlib.sha256()
for path in sorted(tests.rglob("*")) if tests.is_dir() else []:
    if path.is_file() and "__pycache__" not in path.parts:
        digest.update(str(path.relative_to(tests)).encode())
        digest.update(path.read_bytes())

pinned = {}
lock = root / "versions.lock"
if lock.is_file():
    for line in lock.read_text().splitlines():
        key, _, value = line.partition("=")
        pinned[key.strip()] = value.strip()

snapshot["grade"] = {
    "rubric_digest": digest.hexdigest()[:16],
    "judge": snapshot.get("judge"),
    "rewardkit": pinned.get("harbor-rewardkit"),
    "graded_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
}
json.dump(snapshot, open(sys.argv[2], "w"), indent=2)
PY
    echo "trial provenance carried over, grade snapshot replaced, in jobs/$name/nr-snapshot.json"
fi
