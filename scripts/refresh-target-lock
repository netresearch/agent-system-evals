#!/usr/bin/env bash
# Regenerate the pinned dependency set for a case's target.
#
# The targets we review are libraries and do not commit a composer.lock, so a
# plain `composer install` resolves fresh on every build. That makes the
# environment drift with the registry: the same case, built a month apart, is
# not the same case. It also makes builds hostage to advisories published after
# the target commit, which is how this was discovered — the first build of
# OFR-TYPO3-EXT-001 failed outright because TYPO3 12.4.9 had since been flagged.
#
# So the lock is generated once, reviewed, and committed to the case. It is
# copied into the working tree for the install and removed again afterwards, so
# the agent still sees the target exactly as its authors left it.
#
# Running this is a deliberate act: it changes the environment and therefore
# invalidates comparison with results recorded against the previous lock.
# Record a new snapshot identifier when you do.
set -euo pipefail

CASE_DIR="${1:?usage: refresh-target-lock <task-dir>}"
# Absolute: docker -v rejects a relative path as an invalid volume name rather
# than resolving it against the caller's directory.
CASE_DIR="$(cd "$CASE_DIR" && pwd)"
ENV_DIR="$CASE_DIR/environment"
LOCK_FILE="$ENV_DIR/target.lock"

# A target can carry more than one composer tree. Three TYPO3 extensions here
# keep their test stack in a second one under `.Build/`, installed separately
# by their own CI and by this case's build script — pinning only the root
# leaves the stack that actually runs the tests resolving fresh on every build,
# which is the drift this file exists to stop. The case names its trees in
# target.lock; the default is the root alone.
#   TARGET_COMPOSER_TREES=". .Build"
# The lock for the root tree keeps the name it always had, so a case that adds
# a second tree does not rename the file its build script already reads.
lock_name() {
    case "$1" in
        .|"") printf 'target-composer.lock' ;;
        *)    printf 'target-composer-%s.lock' "$(printf '%s' "$1" | sed 's|^\./||; s|^\.||' | tr '/' '-')" ;;
    esac
}

test -f "$LOCK_FILE" || { echo "no target.lock in $ENV_DIR" >&2; exit 1; }
# shellcheck source=/dev/null
. "$LOCK_FILE"
TREES="${TARGET_COMPOSER_TREES:-.}"

# Resolve on the image the case installs on. Composer writes platform
# requirements into the lock, so a set resolved on one PHP and installed on
# another is a different set -- and this script resolved on php:8.3-cli while
# every TYPO3 case has been built `FROM php:8.5-cli` since 30 August. Read from
# the case rather than repeated here, so the two cannot drift apart again.
BASE="$(sed -n 's/^FROM \([^ ]*\).*/\1/p' "$ENV_DIR/Dockerfile" | head -1)"
test -n "$BASE" || { echo "no FROM line in $ENV_DIR/Dockerfile" >&2; exit 1; }

echo "resolving dependencies for $TARGET_PACKAGE @ ${TARGET_COMMIT:0:12} on $BASE"
echo "composer tree(s): $TREES"

for TREE in $TREES; do
OUT="$ENV_DIR/$(lock_name "$TREE")"
echo "--- tree $TREE"

docker run --rm \
    -v "$ENV_DIR:/out" \
    -e COMPOSER_ALLOW_SUPERUSER=1 \
    -e COMPOSER_NO_INTERACTION=1 \
    "$BASE" bash -euo pipefail -c "
        apt-get update -qq && apt-get install -y -qq --no-install-recommends \
            git unzip libzip-dev libicu-dev >/dev/null
        docker-php-ext-install -j\"\$(nproc)\" ftp zip intl >/dev/null
        curl -fsSL https://getcomposer.org/installer -o /tmp/ci.php
        php /tmp/ci.php --install-dir=/usr/bin --filename=composer --quiet

        mkdir -p /src && cd /src
        git init -q .
        git remote add origin '$TARGET_REPOSITORY'
        git fetch -q --depth 1 origin '$TARGET_COMMIT'
        git checkout -q FETCH_HEAD

        # Advisories published after the target commit must not decide whether
        # a historical state can be built. The review of that state is the
        # case; blocking the build would simply delete the case.
        cd '/src/$TREE'

        composer config policy.advisories.block false
        # The TYPO3 installer plugins, allowed for the same reason the build
        # scripts allow them: a repository that declares no allow-plugins is
        # refused outside its usual environment, with a message that reads like
        # a dependency conflict.
        composer config --no-plugins allow-plugins.typo3/cms-composer-installers true >/dev/null 2>&1 || true
        composer config --no-plugins allow-plugins.typo3/class-alias-loader true >/dev/null 2>&1 || true
        composer update --no-interaction --no-progress --no-ansi --no-audit

        # A tree whose composer.json sets config.lock=false produces none, by
        # its maintainers deliberate choice, and composer install would ignore
        # one anyway. Said plainly here rather than dying on a cp: the tree
        # cannot be pinned, and the case has to state that it stays loose.
        if [ ! -f composer.lock ]; then
            echo \"tree '$TREE' writes no composer.lock (config.lock=false in its composer.json) — it cannot be pinned\" >&2
            exit 3
        fi
        cp composer.lock '/out/$(lock_name "$TREE")'
    "

test -s "$OUT" || { echo "no lock produced for tree $TREE" >&2; exit 1; }
echo "wrote $OUT"
python3 - "$OUT" <<'PY'
import json, sys
lock = json.load(open(sys.argv[1]))
pkgs = lock.get("packages", []) + lock.get("packages-dev", [])
print(f"{len(pkgs)} packages pinned; content-hash {lock.get('content-hash', '?')}")
for p in pkgs:
    if p["name"].startswith("typo3/cms-core"):
        print(f"  typo3/cms-core {p['version']}")
PY
done
