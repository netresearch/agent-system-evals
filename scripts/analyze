#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""Read an experiment and say what it establishes, and what it does not.

The unit here is the *experiment*, not the job: an arm is every job it produced
across every stage, pooled, which is what `scripts/run-comparison` writes into
`experiments/`. `scripts/compare` reads exactly two job directories and remains
the right tool for looking at two runs side by side.

What this adds over that:

**Only valid trials count.** The gate in `scripts/lib/validity.py` decides, and
every excluded trial is named with its reason. A rate-limited trial is not a
failed one, and an errored judge's `0.0` is not a score.

**One primary endpoint, declared before the run.** Everything else is
exploratory and labelled so, with Holm-adjusted p-values, because a run reads
every dimension a case grades and a threshold meant for one look is a coin flip
at eight.

**Effect sizes with intervals, never a bare point estimate.** A median of three
published as a 53% saving is the mistake this exists to prevent.

    scripts/analyze experiments/<file>.json
    scripts/analyze --arm control=jobs/a,jobs/b --arm nr=jobs/c --primary outcome_quality
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

import cases  # noqa: E402
import stats  # noqa: E402
import validity  # noqa: E402
from dimensions import met_threshold, order  # noqa: E402

MET = met_threshold()


def check_comparable(a: dict, b: dict, variable: str, label: str) -> None:
    """Everything but the declared variable must match.

    A thin version of the check in `scripts/compare`: it reads the same
    snapshot fields, and its job here is to refuse a pooling that has more than
    one candidate cause rather than to explain the full fingerprint.
    """
    fields = ["case_id", "agent", "model", "judge"]
    if variable == "model":
        fields.remove("model")
        if a.get("fleet") != b.get("fleet"):
            sys.exit(
                f"{label}: both the model and the fleet differ; a result could "
                f"not be attributed to either."
            )
    elif variable == "repository":
        fields.remove("case_id")
    elif a.get("provision_digest") == b.get("provision_digest"):
        sys.exit(
            f"{label}: same provision digest — nothing that is supposed to "
            f"differ does. Use scripts/compare --placebo to measure the "
            f"instrument's own spread deliberately."
        )

    differences = [
        f"{field}: {a.get(field)!r} vs {b.get(field)!r}"
        for field in fields
        if a.get(field) != b.get(field)
    ]
    if differences:
        sys.exit(
            f"{label}: more than the declared variable ({variable}) differs:\n  "
            + "\n  ".join(differences)
        )


class Arm:
    def __init__(self, name: str, jobs: list[Path]):
        self.name = name
        self.jobs = jobs
        self.trials: list[Path] = []
        self.excluded: list[str] = []
        self.snapshot: dict = {}
        self.case_id: str | None = None

        for job in jobs:
            snapshot = validity.read_snapshot(job)
            self.snapshot = self.snapshot or snapshot
            self.case_id = self.case_id or snapshot.get("case_id")
            valid, verdicts = validity.gate(
                job,
                expected_dimensions=(
                    cases.graded_dimensions(self.case_id) if self.case_id else None
                ),
                required_artifacts=(
                    cases.required_artifacts(self.case_id) if self.case_id else None
                ),
            )
            self.trials.extend(valid)
            self.excluded.extend(
                f"{job.name}/{t.name}: {v}"
                for t, v in verdicts.items()
                if not v.valid
            )

    def rewards(self) -> list[dict]:
        out = []
        for trial in self.trials:
            reward = validity.read_json(trial / "verifier" / "reward.json")
            if reward is None:
                result = validity.read_json(trial / "result.json") or {}
                reward = (result.get("verifier_result") or {}).get("rewards")
            if reward:
                out.append(reward)
        return out

    def scores(self, dimension: str) -> list[float]:
        return [r[dimension] for r in self.rewards() if dimension in r]

    def cost(self, field: str = "cost_usd") -> list[float]:
        values = []
        for trial in self.trials:
            result = validity.read_json(trial / "result.json") or {}
            agent = result.get("agent_result") or {}
            if agent.get(field) is not None:
                values.append(float(agent[field]))
        return values

    def tool_calls(self) -> list[float]:
        values = []
        for trial in self.trials:
            trajectory = validity.read_json(trial / "verifier" / "trajectory.json")
            if not isinstance(trajectory, dict):
                continue
            values.append(
                float(
                    sum(
                        len(step.get("tool_calls") or [])
                        for step in trajectory.get("steps", [])
                    )
                )
            )
        return values

    def categories(self, dimension: str) -> dict[str, int]:
        """How the individual criteria of this dimension actually landed.

        The dimension's reward is a mean of criterion scores, and a mean of
        ordinal categories is not a measurement: `NOT_MET`/`PARTIAL`/`MET` at
        0/0.5/1 assumes the two steps are equal, which nobody has checked. The
        distribution says what the mean cannot — whether 0.67 is two clean
        passes and a failure or three shrugs.

        It also exposes the weighting nobody chose: a dimension carried by six
        mechanical criteria and one carried by a single judge criterion behave
        differently at the same 0.75 threshold.
        """
        counts = {"met": 0, "partial": 0, "not_met": 0, "other": 0}
        for trial in self.trials:
            details = validity.read_json(trial / "verifier" / "reward-details.json")
            if not isinstance(details, dict):
                continue
            groups = details.get(dimension) or []
            # One dimension can be recorded as a list of reward groups or as a
            # single group. Reading only the list shape silently dropped three
            # dimensions from this table, which looked like dimensions that
            # have no criteria rather than a reader that could not see them.
            for group in groups if isinstance(groups, list) else [groups]:
                if not isinstance(group, dict):
                    continue
                for criterion in group.get("criteria") or []:
                    value = criterion.get("value")
                    if value == 1.0:
                        counts["met"] += 1
                    elif value == 0.5:
                        counts["partial"] += 1
                    elif value == 0.0:
                        counts["not_met"] += 1
                    else:
                        counts["other"] += 1
        return counts

    def mechanical(self) -> list[float]:
        """Pass/fail per trial where the case declares a ground-truth check."""
        check = cases.metadata(self.case_id or "").get("mechanical_outcome") or {}
        artifacts_glob = check.get("artifacts")
        needle = check.get("all_of")
        if not artifacts_glob or not needle:
            return []
        outcomes = []
        for trial in self.trials:
            artifacts = trial / "artifacts" / "logs" / "artifacts"
            legs = sorted(artifacts.glob(artifacts_glob))
            if not legs:
                outcomes.append(0.0)
                continue
            outcomes.append(
                1.0
                if all(
                    all(token in leg.read_text(errors="ignore") for token in needle)
                    for leg in legs
                )
                else 0.0
            )
        return outcomes


def continuous_row(label: str, a: Arm, b: Arm, values_a, values_b) -> dict:
    if not values_a or not values_b:
        return {"label": label, "skipped": "not recorded on both arms"}
    p, exact = stats.permutation_p(values_a, values_b)
    point, low, high = stats.bootstrap_ci(values_a, values_b)
    return {
        "label": label,
        "a": sorted(values_a),
        "b": sorted(values_b),
        "median_a": stats.median(values_a),
        "median_b": stats.median(values_b),
        "delta_median": point,
        "ci": (low, high),
        "cliffs_delta": stats.cliffs_delta(values_a, values_b),
        "p": p,
        "exact": exact,
    }


def human(value: float, signed: bool = False) -> str:
    """Readable at both ends: dollars to the cent, tokens in millions.

    `41617152.00` is not a number anyone reads; it is the shape of a figure
    nobody checked.
    """
    sign = "+" if signed and value >= 0 else ""
    if abs(value) >= 1_000_000:
        return f"{sign}{value / 1_000_000:.2f}M"
    if abs(value) >= 10_000:
        return f"{sign}{value / 1_000:.1f}k"
    return f"{sign}{value:.2f}"


def show_continuous(row: dict, a: str, b: str) -> None:
    if row.get("skipped"):
        print(f"  {row['label']}: {row['skipped']}")
        return
    print(f"  {row['label']}")
    print(f"    {a}: {'  '.join(human(v) for v in row['a'])}")
    print(f"    {b}: {'  '.join(human(v) for v in row['b'])}")
    low, high = row["ci"]
    interval = (
        "interval not computable from fewer than two trials per arm"
        if low == float("-inf")
        else f"95% CI [{human(low, True)}, {human(high, True)}]"
    )
    print(
        f"    median {human(row['median_a'])} → {human(row['median_b'])} "
        f"({human(row['delta_median'], True)}, {interval})"
    )
    print(
        f"    Cliff's delta {row['cliffs_delta']:+.2f}, "
        f"permutation p {row['p']:.3f}"
        f"{'' if row['exact'] else ' (sampled, not exact)'}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(usage=__doc__)
    parser.add_argument("experiment", nargs="?", type=Path)
    parser.add_argument(
        "--arm",
        action="append",
        default=[],
        metavar="NAME=job[,job...]",
        help="an arm and every job it produced",
    )
    parser.add_argument("--primary", help="the one endpoint this run is powered for")
    parser.add_argument(
        "--variable",
        choices=("fleet", "model", "repository"),
        default="fleet",
        help="what these arms are allowed to differ in; everything else must match",
    )
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    args = parser.parse_args()

    record: dict = {}
    arms: dict[str, list[Path]] = {}
    if args.experiment:
        record = json.loads(args.experiment.read_text())
        for name, jobs in (record.get("jobs") or {}).items():
            arms[name] = [ROOT / j for j in jobs]
    for entry in args.arm:
        name, _, joined = entry.partition("=")
        arms[name] = [Path(j) for j in joined.split(",") if j]
    if len(arms) < 2:
        sys.exit("need at least two arms; pass an experiment record or --arm twice")

    primary = args.primary or record.get("primary_endpoint")
    built = {name: Arm(name, jobs) for name, jobs in arms.items()}
    names = list(built)

    # Comparability, which this script did not check at all until 20 August
    # 2026. It would pool an Opus arm against a Haiku one, or two different
    # cases, and report an effect — while `scripts/compare` refused the same
    # pair. The careful tool blocked what the sloppy one allowed.
    #
    # Every pair, not the first two: three arms are three comparisons, and an
    # unchecked third is exactly the one nobody looks at.
    for index, first in enumerate(names):
        for second in names[index + 1:]:
            check_comparable(
                built[first].snapshot,
                built[second].snapshot,
                variable=args.variable,
                label=f"{first} vs {second}",
            )

    a, b = built[names[0]], built[names[1]]

    print(f"case      {a.case_id}")
    print(f"arms      {' vs '.join(names)}")
    if record.get("seed") is not None:
        print(f"seed      {record['seed']}")
    print(
        f"primary   {primary or 'NOT DECLARED — every result below is exploratory'}"
    )
    if not primary:
        # Said first and plainly. Choosing the endpoint after seeing the data
        # is how eight exploratory looks become one confident finding.
        print(
            "          An endpoint chosen after the fact is not a test of "
            "anything: with eight dimensions, something moves in most runs."
        )

    print("\ntrials")
    for name, arm in built.items():
        print(f"  {name}: {len(arm.trials)} valid of {len(arm.trials) + len(arm.excluded)}")
        for entry in arm.excluded:
            print(f"      excluded — {entry}")
    if len({len(arm.trials) for arm in built.values()}) > 1:
        print(
            "  arms are unequal. That is not fatal and it is not nothing: read "
            "the exclusions above before reading anything below."
        )

    if not all(arm.trials for arm in built.values()):
        sys.exit("\nan arm has no valid trial; there is nothing to compare")

    # --- mechanical ground truth, where the case has any ---------------------
    mech_a, mech_b = a.mechanical(), b.mechanical()
    if mech_a and mech_b:
        hits_a, hits_b = int(sum(mech_a)), int(sum(mech_b))
        lo_a, hi_a = stats.wilson(hits_a, len(mech_a))
        lo_b, hi_b = stats.wilson(hits_b, len(mech_b))
        print("\nmechanical outcome — decided by the framework, not by a judge")
        print(f"  {a.name}: {hits_a}/{len(mech_a)}  [{lo_a:.2f}, {hi_a:.2f}]")
        print(f"  {b.name}: {hits_b}/{len(mech_b)}  [{lo_b:.2f}, {hi_b:.2f}]")
        print(
            f"  Fisher exact p {stats.fisher_p(hits_a, len(mech_a), hits_b, len(mech_b)):.3f} "
            f"(two-sided), {stats.fisher_p(hits_a, len(mech_a), hits_b, len(mech_b), False):.3f} "
            f"(one-sided, observed direction)"
        )

    # --- dimensions ----------------------------------------------------------
    dimensions = order(
        {k for arm in built.values() for reward in arm.rewards() for k in reward}
    )
    raw_p: dict[str, float] = {}
    rows: dict[str, dict] = {}
    for dimension in dimensions:
        values_a, values_b = a.scores(dimension), b.scores(dimension)
        if validity.dimension_state(dimension, a.snapshot) == validity.NOT_APPLICABLE:
            rows[dimension] = {"na": f"{a.name} was offered nothing to choose among"}
            continue
        if not values_a or not values_b:
            rows[dimension] = {"na": "not graded on both arms"}
            continue
        p, exact = stats.permutation_p(values_a, values_b)
        raw_p[dimension] = p
        rows[dimension] = {
            "met_a": sum(1 for v in values_a if v >= MET),
            "met_b": sum(1 for v in values_b if v >= MET),
            "n_a": len(values_a),
            "n_b": len(values_b),
            "cliffs_delta": stats.cliffs_delta(values_a, values_b),
            "p": p,
            "exact": exact,
        }

    adjusted = stats.holm({k: v for k, v in raw_p.items() if k != primary})

    print(f"\ndimensions ({a.name} → {b.name})")
    width = max(len(d) for d in dimensions)
    for dimension in dimensions:
        row = rows[dimension]
        if "na" in row:
            print(f"  {dimension.ljust(width)}  n/a — {row['na']}")
            continue
        tag = "PRIMARY" if dimension == primary else "exploratory"
        suffix = (
            f"p {row['p']:.3f}"
            if dimension == primary
            else f"p {row['p']:.3f} → Holm {adjusted.get(dimension, 1.0):.3f}"
        )
        print(
            f"  {dimension.ljust(width)}  {row['met_a']}/{row['n_a']} → "
            f"{row['met_b']}/{row['n_b']}   delta {row['cliffs_delta']:+.2f}   "
            f"{suffix}   [{tag}]"
        )
        # The criteria behind the number. A dimension's reward is a mean of
        # ordinal categories, and the mean cannot say whether 0.67 is two clean
        # passes and a failure or three shrugs.
        cat_a, cat_b = a.categories(dimension), b.categories(dimension)
        if any(cat_a.values()) or any(cat_b.values()):
            def render(counts):
                return (
                    f"{counts['met']} met / {counts['partial']} partial / "
                    f"{counts['not_met']} not met"
                    + (f" / {counts['other']} other" if counts["other"] else "")
                )
            print(
                f"  {' ' * width}  criteria: {render(cat_a)}  →  {render(cat_b)}"
            )

    print("\ncost — every trial, then the effect")
    show_continuous(continuous_row("agent cost (USD)", a, b, a.cost(), b.cost()), a.name, b.name)
    show_continuous(
        continuous_row("input tokens", a, b, a.cost("n_input_tokens"), b.cost("n_input_tokens")),
        a.name,
        b.name,
    )
    show_continuous(
        continuous_row("tool calls", a, b, a.tool_calls(), b.tool_calls()),
        a.name,
        b.name,
    )

    print("\nreading this")
    print(
        "  A p-value here is exact and still weak: with three trials per arm "
        "the smallest attainable two-sided p is 0.10, so nothing at this size "
        "can clear a conventional threshold. Complete separation is a reason to "
        "spend more trials."
    )
    if primary:
        print(
            f"  Only {primary} was declared in advance. Every other line is "
            f"exploratory: it generates the next experiment's hypothesis and "
            f"is not a finding."
        )

    if args.json:
        print(
            "\n"
            + json.dumps(
                {
                    "case": a.case_id,
                    "arms": names,
                    "primary_endpoint": primary,
                    "valid": {n: len(arm.trials) for n, arm in built.items()},
                    "excluded": {n: arm.excluded for n, arm in built.items()},
                    "dimensions": rows,
                    "holm": adjusted,
                },
                indent=2,
                default=str,
            )
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
