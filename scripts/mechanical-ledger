#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""What every recorded trial did against its case's ground-truth check.

Ten cases declare a `mechanical_outcome`: a file the verifier collects after
the agent stops, and the tokens that must appear in it. Unlike a graded
dimension it cannot drift with the judge, and unlike a dimension it can be
recomputed for any trial ever recorded, because the artefact is on disk.

That is the point of this script. The strongest evidence in this repository
that the stack changes the work rather than the routing -- `nr` passing the
upgrade case's matrix 10 of 10 where the bare agent passed 4 of 10 -- was never
declared as an endpoint by the jobs that produced it, and was found by asking
the artefacts afterwards. A number found that way is a hypothesis, not a
finding, and it stays one; but it should be reproducible by a named command
rather than by a snippet somebody pasted once.

Split by model and by day, never pooled. Both matter and both have already
misled: an arm run on two models reads as one rate (see `invocation-census`),
and on this case every arm reads 0 on 19 August because the collector itself
was broken, which pooled with the next day looks like a capability difference.

    scripts/mechanical-ledger                     # a markdown table
    scripts/mechanical-ledger --case OFR-TYPO3-UPGRADE-001
    scripts/mechanical-ledger --json
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import tomllib
from collections import Counter, defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

import cases  # noqa: E402
import validity  # noqa: E402


def declarations() -> dict[str, dict]:
    """Case id -> its mechanical_outcome, for the cases that declare one."""
    out = {}
    for task in sorted(ROOT.glob("tasks/*/*/task.toml")):
        meta = tomllib.load(task.open("rb")).get("metadata", {})
        check = meta.get("mechanical_outcome")
        if check and meta.get("case_id"):
            out[meta["case_id"]] = check
    return out


def passed(artifacts: Path, check: dict) -> bool:
    """The same reading `scripts/analyze` uses, against one trial's artefacts.

    An absent artefact is a failure rather than a gap: the collector runs
    whatever the agent did, so a missing file means the check could not be
    made, and counting that as anything else invents a pass.
    """
    legs = sorted(artifacts.glob(check["artifacts"]))
    if not legs:
        return False
    return all(
        all(token in leg.read_text(errors="ignore") for token in check["all_of"])
        for leg in legs
    )


# How far a trial got, for a case whose ground truth is a matrix of legs. The
# mechanical outcome is a switch: every leg green or nothing. That is the right
# endpoint -- an upgrade that half works has not happened -- but it is blind to
# movement, and on the upgrade case there has been plenty: the same arm went
# from never resolving the dependency, to resolving it and failing to load the
# suite, to running 719 tests with three errors. All of that reads 0.
#
# So the rungs are recorded beside it, never instead of it. They are read off
# the same artefacts and they are exploratory by construction: no run is
# declared on them, and a run that improves a rung without reaching the top has
# still not passed.
RUNGS = (
    "1 no install",       # the manifest did not admit the target line
    "2 suite will not load",  # installed; PHPUnit died resolving something
    "3 suite runs",       # tests executed, some failed
    "4 green",            # what mechanical_outcome counts
)


def rung(artifacts: Path, check: dict) -> str:
    """Which rung a trial reached, from the same files `passed` reads."""
    legs = sorted(artifacts.glob(check["artifacts"]))
    if not legs:
        return RUNGS[0]
    text = "\n".join(leg.read_text(errors="ignore") for leg in legs)
    if passed(artifacts, check):
        return RUNGS[3]
    # Nothing that says the target was installed puts a trial on the bottom
    # rung, and that includes a collected file with nothing in it. An empty
    # artefact is the same information as a missing one, and reading it as
    # "the suite would not load" would credit the trial with an install it
    # never demonstrated -- the absence-as-evidence mistake this repository
    # keeps finding in its own instruments.
    if not re.search(r"resolve:|^LEG=", text, re.M):
        return RUNGS[0]
    if re.search(r"^RESOLVE=failed", text, re.M) or "INSTALLED=none" in text:
        return RUNGS[0]
    # A test summary line means PHPUnit got far enough to run something; a
    # fatal or an "an error occurred inside PHPUnit" means it did not.
    if re.search(r"^Tests: \d+", text, re.M):
        return RUNGS[2]
    return RUNGS[1]


def short_model(model: str) -> str:
    name = model.removeprefix("claude-")
    head, _, tail = name.rpartition("-")
    return head if head and tail.isdigit() and len(tail) == 8 else name


def ledger(jobs_dir: Path | None = None) -> dict:
    declared = declarations()
    rows: dict[str, dict[tuple[str, str, str], list]] = defaultdict(
        lambda: defaultdict(lambda: [0, 0, Counter()])
    )
    for job in sorted((jobs_dir or ROOT / "jobs").glob("*")):
        # The shared reader, not json.loads: it is version-checked and raises
        # on a record from a future writer, where parsing by hand skips the job
        # silently and the ledger then reports a total that is quietly short.
        # `read_snapshot` returns {} where there is no snapshot at all, which is
        # the case this loop skips.
        recorded = validity.read_snapshot(job)
        if not recorded:
            continue
        case = recorded.get("case_id")
        check = declared.get(case)
        if not check:
            continue
        key = (
            recorded.get("fleet") or "unknown",
            short_model(recorded.get("model") or "unrecorded"),
            job.name.rsplit("-", 2)[-2],
        )
        # Only trials the repository already counts. The first version of this
        # script did not ask, and read 0 for every arm on 19 August -- jobs
        # whose trials had all raised ApiRateLimitError, spent zero tokens and
        # never ran an agent. Counted as failures they look like a capability
        # collapse across five fleets in one night, which is what they were
        # first written up as.
        valid, _ = validity.gate(
            job,
            expected_dimensions=cases.graded_dimensions(case),
            required_artifacts=cases.required_artifacts(case),
        )
        for trial in valid:
            artifacts = trial / "artifacts" / "logs" / "artifacts"
            rows[case][key][0] += passed(artifacts, check)
            rows[case][key][1] += 1
            rows[case][key][2][rung(artifacts, check)] += 1
    return {case: dict(sorted(by_key.items())) for case, by_key in sorted(rows.items())}


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--case", help="one case id, instead of all of them")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    rows = ledger()
    if args.case:
        rows = {k: v for k, v in rows.items() if k == args.case}
        if not rows:
            print(f"no recorded trials for {args.case}", file=sys.stderr)
            return 1

    if args.json:
        print(json.dumps(
            {
                case: {
                    "|".join(k): {"passed": v[0], "trials": v[1],
                                  "rungs": dict(v[2])}
                    for k, v in by.items()
                }
                for case, by in rows.items()
            },
            indent=2,
        ))
        return 0

    declared = declarations()
    for case, by_key in rows.items():
        check = declared[case]
        print(f"\n### {case} — `{check['artifacts']}` must contain "
              f"{', '.join(repr(t) for t in check['all_of'])}\n")
        print("| arm | model | day | passed | how far the rest got |")
        print("|---|---|---|---|---|")
        for (fleet, model, day), (ok, n, rungs) in by_key.items():
            short = ", ".join(f"{r[2:]} {c}" for r, c in sorted(rungs.items())
                              if not r.startswith("4"))
            print(f"| `{fleet}` | {model} | {day} | {ok}/{n} | {short or '—'} |")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
