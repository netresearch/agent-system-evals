#!/usr/bin/env -S uv run --quiet --with pyyaml --script
# /// script
# requires-python = ">=3.12"
# ///
"""Run an A/B in alternating blocks, and only as deep as the answer needs.

Two problems this addresses, both found in this repository's own results.

**Order.** Every comparison before this ran one arm to completion and then the
other, hours apart. A model update, a caching change or a quiet backend
migration in between arrives as a difference between arms and is
indistinguishable from one. Here the arms alternate per stage in a shuffled
order, so a drift over the session is split across them rather than landing on
one.

That is *block* randomisation, not trial-level interleaving: a stage still runs
one arm's three trials back to back, because a job is the unit `scripts/compare`
reads. Within a stage, a drift can still fall on one side. The docstring used to
claim `A B, B A, A B` — trial by trial — which this has never done; saying so
here rather than in an issue alone, because a comment that overstates the method
is how a reader stops checking. Tracked in issue #2.

**Depth.** Three trials per arm was treated as the measurement. It is not: on
the runtime case the spread inside one arm covered the gap between arms, and a
median difference got published as a 53% saving before the per-trial figures
were looked at. Three trials answer "is anything obviously happening"; nothing
more. So the run starts at three, and continues only where the result is close
enough that more trials could settle it.

Every run writes `experiments/<stamp>-<case>.json`: the seed, the arms, the
stage sizes, the jobs each stage produced and why it stopped. Without it the
seed is unrecoverable and the run is not reproducible even in principle.

    scripts/run-comparison <case-id> --arms control,nr [--max-trials 12]
"""

from __future__ import annotations

import argparse
import json
import os
import random
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MET = 0.75

# Three is enough to notice a difference and never enough to establish one.
DISCOVERY = 3
# Complete separation of two groups of three happens by chance one time in ten.
# Six exchangeable observations admit C(6,3) = 20 orderings and two of them are
# completely separated — all of A below all of B, or all of B below all of A.
# The check below tests both directions, so the figure is 2/20 and not the 1/20
# this comment, docs/open-forward-review.md and the published page all used to
# state. One in twenty is the one-sided figure, and would only apply to a
# direction named before the data were seen, which none of them was.
#
# It is also read across every dimension a case grades. Eight independent
# dimensions at one in ten would produce at least one separation by chance in
# roughly half of all runs; they are not independent, but nothing here corrects
# for the multiplicity either. So separation is a reason to spend more trials
# and is never itself a result. Tracked in issue #3.
STAGES = (3, 4, 5)


def trials_of(job_dir: Path) -> list[dict]:
    rows = []
    for trial in sorted(job_dir.glob("*__*")):
        result = trial / "result.json"
        if result.is_file():
            rows.append(json.loads(result.read_text()))
    return rows


def dimension_scores(job_dir: Path) -> dict[str, list[float]]:
    scores: dict[str, list[float]] = {}
    for trial in sorted(job_dir.glob("*__*")):
        details = trial / "verifier" / "reward-details.json"
        if not details.is_file():
            continue
        for dimension, block in json.loads(details.read_text()).items():
            block = block if isinstance(block, dict) else (block or [{}])[0]
            if isinstance(block, dict) and "score" in block:
                scores.setdefault(dimension, []).append(block["score"])
    return scores


def mechanical_outcome(job_dir: Path) -> list[float] | None:
    """Pass/fail per trial where the case has ground truth, else None.

    The separation test reads graded dimensions, and on the upgrade case that
    missed the thing worth watching: `verification` separated once and not
    again — noise — while the matrix outcome, which the framework itself
    decides, reproduced exactly across two independent runs. A dimension a
    judge scored moved the deepening; the fact that repeated did not.
    """
    outcomes = []
    for trial in sorted(job_dir.glob("*__*")):
        artifacts = trial / "artifacts" / "logs" / "artifacts"
        legs = sorted(artifacts.glob("matrix-*.txt"))
        if not legs:
            return None
        complete = all(
            "resolve: ok" in leg.read_text(errors="ignore")
            and "\nOK (" in leg.read_text(errors="ignore")
            for leg in legs
        )
        outcomes.append(1.0 if complete else 0.0)
    return outcomes or None


def separated(a: list[float], b: list[float]) -> bool:
    """Do the two samples not overlap at all?

    The strongest statement small samples can make, and the trigger for
    spending more of them. Deliberately not a p-value: with three per side the
    only distinguishable outcomes are "completely separated" and "not", and
    dressing that up as significance would overstate it.
    """
    return bool(a) and bool(b) and (max(a) < min(b) or max(b) < min(a))


def run_arm(case_id: str, fleet: str, trials: int, env: dict) -> Path | None:
    command = [
        str(ROOT / "scripts" / "run-evaluation"),
        case_id,
        "--fleet",
        fleet,
        "--trials",
        str(trials),
    ]
    print(f"  → {fleet}: {trials} trial(s)")
    result = subprocess.run(command, env=env, capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stdout[-2000:], file=sys.stderr)
        print(result.stderr[-2000:], file=sys.stderr)
        return None
    jobs = sorted(
        (ROOT / "jobs").glob(f"{case_id}-{fleet}-*"), key=lambda p: p.stat().st_mtime
    )
    return jobs[-1] if jobs else None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("case_id")
    parser.add_argument("--arms", required=True, help="comma-separated fleets")
    parser.add_argument("--max-trials", type=int, default=12)
    parser.add_argument("--seed", type=int, default=None,
                        help="fix the interleaving order, for reproduction")
    args = parser.parse_args()

    arms = [a.strip() for a in args.arms.split(",") if a.strip()]
    if len(arms) < 2:
        sys.exit("--arms needs at least two fleets")

    rng = random.Random(args.seed)
    env = dict(os.environ)
    if not env.get("CLAUDE_CODE_OAUTH_TOKEN") and not env.get("ANTHROPIC_API_KEY"):
        sys.exit("no credential; see scripts/run-evaluation")

    collected: dict[str, list[Path]] = {arm: [] for arm in arms}
    spent = 0
    stop_reason = "stages exhausted"
    record: dict = {
        "case": args.case_id,
        "arms": arms,
        "seed": args.seed,
        "max_trials": args.max_trials,
        "stages": [],
    }
    experiments = ROOT / "experiments"
    experiments.mkdir(exist_ok=True)
    log = experiments / f"{args.case_id}-{len(list(experiments.iterdir())):03d}.json"

    def save() -> None:
        record["stop_reason"] = stop_reason
        record["trials_spent"] = spent
        record["jobs"] = {
            arm: [str(job.relative_to(ROOT)) for job in jobs]
            for arm, jobs in collected.items()
        }
        log.write_text(json.dumps(record, indent=2))

    for stage, size in enumerate(STAGES, start=1):
        # Checked against what a full stage would cost, not against what has
        # already been spent. The first version tested `spent >= max_trials`
        # before a stage and then let the stage run in full, so `--max-trials
        # 12` with two arms ran fourteen: 3+3 leaves six spent, under the
        # limit, and stage two adds eight more. A budget that can be exceeded
        # by two thirds of a stage is not a budget.
        remaining = args.max_trials - spent
        if remaining < len(arms):
            stop_reason = f"budget exhausted ({spent} of {args.max_trials} trials)"
            print(f"\n{stop_reason}")
            break
        size = min(size, remaining // len(arms))

        # Shuffled per stage so a systematic drift over the session does not
        # always favour the same side.
        order = list(arms)
        rng.shuffle(order)
        print(f"\nstage {stage}: {size} trial(s) per arm, order {' '.join(order)}")
        record["stages"].append({"stage": stage, "size": size, "order": order})
        for fleet in order:
            job = run_arm(args.case_id, fleet, size, env)
            if job is None:
                # Fail closed. Continuing would leave one arm with fewer trials
                # than the other and no note in the output saying so, and the
                # comparison would read the imbalance as a result.
                stop_reason = f"arm {fleet} failed in stage {stage}"
                print(f"\n{stop_reason}; stopping rather than comparing "
                      f"unequal arms.", file=sys.stderr)
                save()
                print(f"experiment record: {log.relative_to(ROOT)}")
                return 1
            collected[fleet].append(job)
            spent += size

        if stage == 1:
            # Stop unless something looks like it is happening. A dimension
            # that already separates completely is worth more trials; one that
            # overlaps is not going to be settled by them either.
            #
            # Every pair of arms, not the first two. `--arms a,b,c` was accepted
            # and then decided on `a` against `b` alone, so a third arm's trials
            # were paid for and could neither trigger the deepening nor stop it.
            interesting: list[str] = []

            def outcome_of(jobs):
                runs = [o for o in (mechanical_outcome(j) for j in jobs) if o]
                return [v for run in runs for v in run]

            for i, first in enumerate(arms):
                for second in arms[i + 1:]:
                    scores_a, scores_b = merged(collected[first]), merged(collected[second])

                    # Ground truth first, where the case has any, and judged by
                    # a different rule. Complete separation is meaningless for a
                    # pass/fail outcome — [0,1,1] against [1,1,1] can never
                    # separate, though the difference is exactly the finding.
                    # Any gap in the pass rate is worth more trials, because it
                    # is the one number no judge decided.
                    out_a, out_b = outcome_of(collected[first]), outcome_of(collected[second])
                    if out_a and out_b and sum(out_a) / len(out_a) != sum(out_b) / len(out_b):
                        note = (
                            f"{first} vs {second}: mechanical outcome differs — "
                            f"{sum(out_a):.0f}/{len(out_a)} against "
                            f"{sum(out_b):.0f}/{len(out_b)}"
                        )
                        print(f"  {note} — continuing")
                        interesting.append(note)

                    for dimension in sorted(set(scores_a) | set(scores_b)):
                        if separated(scores_a.get(dimension, []), scores_b.get(dimension, [])):
                            note = f"{first} vs {second}: {dimension} separates completely"
                            print(f"  {note} — continuing")
                            interesting.append(note)

            record["stages"][-1]["separations"] = interesting
            if not interesting:
                stop_reason = "nothing separated after the discovery stage"
                print(f"\n{stop_reason}; stopping.")
                print("Three trials per arm cannot establish a difference, and "
                      "nothing here suggests one is there to establish.")
                break

    save()
    print("\njobs:")
    for fleet, jobs in collected.items():
        for job in jobs:
            print(f"  {fleet}: {job.relative_to(ROOT)}")
    print(f"\nexperiment record: {log.relative_to(ROOT)}")
    print("Compare them with scripts/compare, and read the per-trial figures "
          "before any median.")
    return 0


def merged(jobs: list[Path]) -> dict[str, list[float]]:
    out: dict[str, list[float]] = {}
    for job in jobs:
        for dimension, values in dimension_scores(job).items():
            out.setdefault(dimension, []).extend(values)
    return out


if __name__ == "__main__":
    sys.exit(main())
