#!/usr/bin/env -S uv run --quiet --with pyyaml --script
# /// script
# requires-python = ">=3.12"
# ///
"""Fail if the skill fleet has been told the answers.

A benchmark is evidence only while the system under test has not seen the
expected results. The realistic route to losing that is not sabotage: skills
are updated continuously from real work by people who also see the cases, and a
well-meant update can encode a case's finding without anyone deciding to change
the benchmark.

Scans the fleet as pinned for:

  - case identifiers
  - the target repository, owner and package name
  - the target commit SHA, full and abbreviated
  - distinctive sentences from case instructions
  - distinctive phrases from verifier-side known-concerns files

A hit is not automatically contamination — a skill may legitimately mention
TYPO3 or a common word — so hits are reported with their context for a human to
judge, and the exit status marks the run as needing that judgement. A hit
judged a learning is recorded in the case's
`tests/contamination-decisions.yaml`, pinned to the skill ref it was judged
at, and no longer fails the run; a hit judged contamination is fixed in the
skill, never recorded.

    scripts/contamination-check --fleet main
"""

from __future__ import annotations

import argparse
import io
import re
import sys
import tarfile
import tomllib
import urllib.request
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]

# Extensions worth reading. Skills are prose and configuration; a hit inside a
# binary is not a learning anyone wrote.
TEXT_SUFFIXES = {".md", ".txt", ".toml", ".yaml", ".yml", ".json", ".py", ".sh"}

# Words too common to signal anything on their own.
STOPWORDS = {
    "typo3", "extension", "review", "composer", "php", "test", "tests",
    "the", "this", "that", "what", "needs", "attention", "and", "for",
}


def fleet_skills(name: str) -> list[tuple[str, str]]:
    path = ROOT / "fleets" / f"{name}.yaml"
    if not path.exists():
        sys.exit(f"no fleet {name!r}")
    fleet = yaml.safe_load(path.read_text()) or {}
    return [(s["repo"], s["ref"]) for s in (fleet.get("skills") or [])]


def distinctive(marker: str) -> bool:
    """Could this string only appear because someone knew the case?

    A marker is evidence when it is unlikely to occur by accident. One *all
    lowercase* word with no separator and no digit is not: `synthetic` matched
    twelve times across four skills, and `contexts` — the last segment of
    `netresearch/contexts` — is one edit away from doing the same.

    Everything else stays: a multi-word sentence from the instruction, anything
    hyphenated or namespaced, and any identifier carrying a capital.
    `DumpFileTrait` is one word of thirteen lowercase-ish characters and is a
    declared marker of the review case — the first version of this predicate
    dropped it, which would have widened the check's blind spot while reporting
    that it had narrowed it.
    """
    if len(marker.split()) > 1:
        return True
    if marker != marker.lower():
        return True
    return bool(re.search(r"[-_/.\d]", marker)) or len(marker) >= 16


def case_markers() -> dict[str, list[str]]:
    """Strings that must not appear in any skill, grouped by case."""
    markers: dict[str, list[str]] = {}

    for config_path in ROOT.glob("tasks/*/*/task.toml"):
        case_dir = config_path.parent
        config = tomllib.loads(config_path.read_text())
        metadata = config.get("metadata", {})
        case_id = metadata.get("case_id")
        if not case_id:
            continue

        found = [case_id]

        repository = metadata.get("target_repository", "")
        # A contract eval writes its own extension and declares
        # `target_repository = "synthetic"`. That is a sentinel, not a slug, and
        # deriving markers from it made the ordinary English word "synthetic"
        # a contamination marker: twelve hits across four skills, on sentences
        # like "synthetic fixtures excluded from coverage". The check failed on
        # every run for days and the failure said nothing.
        if repository and repository != "synthetic":
            slug = re.sub(r"^https?://[^/]+/|\.git$", "", repository)
            found.append(slug)
            found.append(slug.split("/")[-1])

        package = metadata.get("target_package")
        if package:
            found.append(package)

        sha = metadata.get("target_sha", "")
        if sha:
            found.extend([sha, sha[:12], sha[:7]])

        instruction = case_dir / "instruction.md"
        if instruction.exists():
            for sentence in re.split(r"[.\n]", instruction.read_text()):
                sentence = sentence.strip()
                # Long enough to be distinctive; a short phrase from an
                # instruction as ordinary as ours matches everywhere.
                if len(sentence.split()) >= 6:
                    found.append(sentence)

        # Markers from the known-concerns file are declared, not harvested.
        #
        # The first version scraped every backticked token, which produced 378
        # hits across eight skills — `README.md`, `tests/`, `composer.lock`.
        # Those are ordinary words in any engineering repository, and a check
        # that cries wolf 378 times gets skipped, which is a worse failure than
        # not having it. What counts as leakage for a given case is a judgement
        # its author has to make explicitly:
        #
        #     <!-- contamination-markers: DumpFileTrait, SyncImportTask -->
        concerns = case_dir / "tests" / "known-concerns.md"
        if concerns.exists():
            declared = re.search(
                r"<!--\s*contamination-markers:\s*(.+?)\s*-->",
                concerns.read_text(),
                re.S,
            )
            if declared:
                found.extend(
                    token.strip()
                    for token in declared.group(1).split(",")
                    if token.strip()
                )
            else:
                print(
                    f"warning: {concerns.relative_to(ROOT)} declares no "
                    f"contamination-markers; only generic case markers will "
                    f"be checked for this case",
                    file=sys.stderr,
                )

        kept, dropped = [], []
        for marker in dict.fromkeys(found):
            if not marker or marker.lower() in STOPWORDS:
                continue
            (dropped if not distinctive(marker) else kept).append(marker)
        if dropped:
            # Said out loud rather than filtered silently: a marker that cannot
            # indicate contamination is a gap in the case's coverage, and a
            # gap nobody is told about is how a check keeps passing.
            print(
                f"note: {case_id} drops non-distinctive marker(s) "
                f"{sorted(dropped)} — a single lowercase word matches ordinary "
                f"prose and cannot be evidence. Declare a specific marker in "
                f"tests/known-concerns.md instead.",
                file=sys.stderr,
            )
        markers[case_id] = kept

    if not markers:
        sys.exit("no cases found; nothing to check")
    return markers


def case_decisions() -> dict[tuple[str, str, str, str, str], str]:
    """Recorded human decisions, keyed (case, skill, ref, path, marker).

    Each entry is a reported hit a human judged a learning by the test in
    docs/contamination.md. The value is the recorded reason. Pinned to the
    skill ref: a fleet moving to a new version lapses the decision, and the
    new version's text is judged fresh.
    """
    required = ("skill", "ref", "path", "marker", "reason")
    decisions: dict[tuple[str, str, str, str, str], str] = {}

    for path in ROOT.glob("tasks/*/*/tests/contamination-decisions.yaml"):
        config = tomllib.loads((path.parent.parent / "task.toml").read_text())
        case_id = config.get("metadata", {}).get("case_id")
        if not case_id:
            continue
        for entry in yaml.safe_load(path.read_text()) or []:
            # A malformed decision silently accepting nothing would read as
            # safety; refuse it loudly instead. Fields must be strings: a
            # YAML null passes a truthiness check as the string "None", and
            # an unquoted number (a Forge issue used as a marker, say)
            # parses as int and then never matches the string it was meant
            # to accept.
            if not isinstance(entry, dict) or not all(
                isinstance(entry.get(k), str) and entry[k].strip()
                for k in required
            ):
                sys.exit(
                    f"{path.relative_to(ROOT)}: decision needs non-empty "
                    f"string {', '.join(required)}: {entry}"
                )
            key = (
                case_id,
                entry["skill"],
                entry["ref"],
                entry["path"],
                entry["marker"],
            )
            if key in decisions:
                sys.exit(
                    f"{path.relative_to(ROOT)}: duplicate decision for "
                    f"{entry['skill']}@{entry['ref']}: {entry['path']} / "
                    f"{entry['marker']!r}"
                )
            decisions[key] = entry["reason"]

    return decisions


def fetch_skill(repo: str, ref: str) -> list[tuple[str, str]]:
    """Return (path, text) for the text files of a skill at a pinned ref."""
    url = f"https://codeload.github.com/{repo}/tar.gz/refs/tags/{ref}"
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read()
    except Exception:
        # Tag lookup failed; a candidate fleet may pin a branch.
        url = f"https://codeload.github.com/{repo}/tar.gz/refs/heads/{ref}"
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read()

    files = []
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        for member in archive.getmembers():
            if not member.isfile():
                continue
            if Path(member.name).suffix.lower() not in TEXT_SUFFIXES:
                continue
            handle = archive.extractfile(member)
            if handle is None:
                continue
            files.append(
                (member.name, handle.read().decode("utf-8", errors="replace"))
            )
    return files


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fleet", default="main")
    args = parser.parse_args()

    markers = case_markers()
    decisions = case_decisions()
    skills = fleet_skills(args.fleet)

    if not skills:
        print(f"fleet {args.fleet!r} injects no skills; nothing to contaminate")
        return 0

    total_markers = sum(len(v) for v in markers.values())
    print(
        f"checking {len(skills)} skill(s) in fleet {args.fleet!r} against "
        f"{total_markers} marker(s) from {len(markers)} case(s)"
    )

    hits: list[str] = []
    accepted: list[str] = []
    used: set[tuple[str, str, str, str, str]] = set()
    fetched: set[tuple[str, str]] = set()
    for repo, ref in skills:
        try:
            files = fetch_skill(repo, ref)
            fetched.add((repo, ref))
        except Exception as exc:  # noqa: BLE001
            # An unreachable skill is an unchecked skill. Reporting this as a
            # pass would be the worst outcome: silence that reads as safety.
            print(f"  ! {repo}@{ref}: could not fetch ({exc})", file=sys.stderr)
            hits.append(f"{repo}@{ref}: NOT CHECKED — could not fetch")
            continue

        for case_id, case_markers_list in markers.items():
            for marker in case_markers_list:
                for path, text in files:
                    if marker.lower() in text.lower():
                        key = (case_id, repo, ref, path, marker)
                        if key in decisions:
                            used.add(key)
                            accepted.append(
                                f"{repo}@{ref}: {path} mentions {marker!r} "
                                f"— {decisions[key]}"
                            )
                            continue
                        line = next(
                            (
                                l.strip()
                                for l in text.splitlines()
                                if marker.lower() in l.lower()
                            ),
                            "",
                        )
                        hits.append(
                            f"{repo}@{ref}: {path} mentions {marker!r} "
                            f"(case {case_id})\n      {line[:160]}"
                        )
        print(f"  checked {repo}@{ref} ({len(files)} text files)")

    if accepted:
        print(f"\n{len(accepted)} hit(s) accepted by recorded decision:")
        for entry in accepted:
            print(f"  - {entry}")

    # A decision that no longer matches anything while its skill@ref was
    # scanned is dead configuration — the case's marker list changed under it.
    # Not fatal: decisions for skills outside this fleet are expected to sit
    # idle, and content at a pinned ref cannot change without moving the tag.
    for key, _reason in decisions.items():
        case_id, repo, ref, path, marker = key
        if (repo, ref) in fetched and key not in used:
            print(
                f"warning: unused decision for {repo}@{ref}: {path} / "
                f"{marker!r} (case {case_id})",
                file=sys.stderr,
            )

    if hits:
        print(f"\n{len(hits)} possible contamination hit(s):", file=sys.stderr)
        for hit in hits:
            print(f"  - {hit}", file=sys.stderr)
        print(
            "\nA hit needs a human decision. The question is whether the text "
            "would help an agent on a repository it has never seen (a "
            "learning) or only on this target (contamination). See "
            "docs/contamination.md.",
            file=sys.stderr,
        )
        return 1

    print("\nno case-specific knowledge found in the fleet")
    return 0


if __name__ == "__main__":
    sys.exit(main())
