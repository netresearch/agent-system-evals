#!/usr/bin/env -S uv run --quiet --with harbor==0.21.0 --script
# /// script
# requires-python = ">=3.12,<3.14"
# ///
"""Validate every case with Harbor's own validator, and report the reason.

Harbor decides whether a directory is a task with ``Task.is_valid_dir``,
which swallows the validation error and returns a bare False. A run then fails
with "There are 0 tasks available in this dataset", which says nothing about
what is wrong. That cost an hour here: the actual fault was one field —
``authors`` as a list of strings where Harbor wants a list of tables — and
nothing in the failure pointed at it.

So this re-runs the same validation and prints what Harbor would not.

On top of Harbor's checks it enforces the repository's own rules, which Harbor
has no reason to know: a separate verifier (ADR 0004), no solution in an open
case (ADR 0003), and complete provenance metadata.
"""

from __future__ import annotations

import sys
import tomllib
from pathlib import Path

from harbor.models.task.config import TaskConfig
from harbor.models.task.paths import TaskPaths
from harbor.models.task.task import Task

ROOT = Path(__file__).resolve().parents[1]

REQUIRED_METADATA = (
    "case_id",
    "target_repository",
    "target_sha",
    "source_learning_id",
)


def companion_pin() -> str | None:
    """The commit the companion fleets are pinned to, if that fleet exists."""
    import yaml

    fleet = ROOT / "fleets" / "companion.yaml"
    if not fleet.exists():
        return None
    return (yaml.safe_load(fleet.read_text()) or {}).get("companion", {}).get("ref")


def _line_tuple(line: str) -> tuple[int, ...]:
    return tuple(int(p) for p in line.split(".") if p.isdigit())


def check_runtime_mcp_servers(
    case_dir: Path, label: Path, config: dict, problems: list[str]
) -> None:
    """A fleet that declares `requires: runtime` must be installable here.

    Same failure as the companion's, one level further in: a runtime fleet
    whose package is missing from the image produces trials that are
    indistinguishable from a control run, and nothing fails while it happens.
    Repository-level cases are exempt by the fleet's own declaration, because
    a server that reads a booted TYPO3 has nothing to answer from a checkout.
    """
    import yaml

    if not config.get("metadata", {}).get("runtime"):
        return

    # What the instance runs, from the case's own lock file.
    lock = case_dir / "environment" / "target.lock"
    line = ""
    if lock.exists():
        for row in lock.read_text().splitlines():
            if row.startswith("TYPO3_LINE="):
                line = row.split("=", 1)[1].strip()

    dockerfile = case_dir / "environment" / "Dockerfile"
    if not dockerfile.exists():
        return
    text = dockerfile.read_text()

    for fleet_path in sorted((ROOT / "fleets").glob("*.yaml")):
        fleet = yaml.safe_load(fleet_path.read_text()) or {}
        floor = fleet.get("min_typo3_line")
        if not floor:
            continue
        # A fleet whose own requirements the case cannot meet is not a gap in
        # the case. The review target declares TYPO3 ^12.4, so its developer's
        # instance is v12.4, and a server requiring ^13.4 has no place there.
        if line and _line_tuple(line) < _line_tuple(str(floor)):
            continue
        package = fleet.get("package")
        if not package:
            problems.append(
                f"fleets/{fleet_path.name}: requires runtime but names no "
                f"package, so nothing can check that a case installs it"
            )
            continue
        name, _, version = package.partition(":")
        if name not in text:
            problems.append(
                f"{label}: runtime case does not install {name}, required by "
                f"fleets/{fleet_path.name}; that arm would be a control run"
            )
        elif version and version not in text:
            problems.append(
                f"{label}: installs {name} at a version other than {version}, "
                f"which fleets/{fleet_path.name} pins"
            )


def check_fleet_toolchain(case_dir: Path, label: Path, problems: list[str]) -> None:
    """A fleet that puts a directory on PATH needs a case that fills it.

    The toolchain arrives through `--agent-env PATH=…`, and a PATH entry that
    does not exist is not an error on any system: the shell skips it. So a case
    missing the layer produces an arm labelled as the deployed stack, running
    with none of its tools, with nothing failing anywhere — the exact shape this
    repository keeps having to defend against.
    """
    import yaml

    env_dir = case_dir / "environment"
    if not env_dir.is_dir():
        return
    # The whole environment, not the Dockerfile alone: the directory is created
    # by a script the Dockerfile calls, so the path appears there rather than in
    # the build file. Checking only the Dockerfile reported all three cases as
    # broken, including the one that demonstrably has the toolchain.
    text = "\n".join(
        p.read_text()
        for p in sorted(env_dir.iterdir())
        if p.is_file() and p.suffix in ("", ".sh") or p.name == "Dockerfile"
    )

    for fleet_path in sorted((ROOT / "fleets").glob("*.yaml")):
        fleet = yaml.safe_load(fleet_path.read_text()) or {}
        path_value = (fleet.get("env") or {}).get("PATH")
        if not path_value:
            continue
        for entry in str(path_value).split(":"):
            if entry.startswith("/opt/") and entry not in text:
                problems.append(
                    f"{label}: fleets/{fleet_path.name} puts {entry} on PATH "
                    f"and environment/Dockerfile does not create it; that arm "
                    f"would run with none of its tools"
                )


def check_companion_server(case_dir: Path, label: Path, problems: list[str]) -> None:
    """Every case must be able to host the companion, at the fleet's commit.

    The companion's MCP server is a PHP process the client starts over stdio, so
    it lives in the agent image while only the config pointing at it varies per
    fleet. A case that omits it still *runs* the companion fleets: they get the
    skills and a config aimed at a path that does not exist, and the result is
    an arm labelled `companion` that measured companion-without-a-server.

    Nothing failed when this happened — the trials completed and produced
    scores. So it is checked here rather than discovered in a results table.
    """
    ref = companion_pin()
    if ref is None:
        return

    dockerfile = case_dir / "environment" / "Dockerfile"
    if not dockerfile.exists():
        return
    text = dockerfile.read_text()

    if "typo3-dev-companion" not in text:
        problems.append(
            f"{label}: environment/Dockerfile does not install the companion's "
            f"MCP server, but fleets/companion.yaml exists — the companion "
            f"fleets would run against a server that is not there"
        )
    elif ref not in text:
        problems.append(
            f"{label}: the companion server in environment/Dockerfile is not "
            f"pinned to {ref[:12]}, the commit fleets/companion.yaml pins its "
            f"skills to; skills and server would come from different versions"
        )


def main() -> int:
    problems: list[str] = []
    checked = 0

    for config_path in sorted(ROOT.glob("tasks/*/*/task.toml")):
        case_dir = config_path.parent
        label = case_dir.relative_to(ROOT)
        checked += 1
        paths = TaskPaths(case_dir)
        check_companion_server(case_dir, label, problems)
        check_fleet_toolchain(case_dir, label, problems)

        # Harbor's own validation, with the error surfaced instead of hidden.
        try:
            config = TaskConfig.model_validate_toml(config_path.read_text())
        except Exception as exc:  # noqa: BLE001
            problems.append(f"{label}: task.toml rejected by Harbor:\n      {exc}")
            continue

        try:
            Task._validate_tests(config, paths)
        except FileNotFoundError as exc:
            problems.append(f"{label}: tests layout invalid: {exc}")

        if not Task.is_valid_dir(case_dir):
            problems.append(
                f"{label}: Harbor rejects this directory even though the "
                f"config parsed. Harbor would report it as '0 tasks available'."
            )

        # Repository rules.
        raw = tomllib.loads(config_path.read_text())
        check_runtime_mcp_servers(case_dir, label, raw, problems)
        if raw.get("schema_version") != "1.4":
            problems.append(f"{label}: schema_version is not 1.4")

        if config.verifier.environment_mode is None or (
            config.verifier.environment_mode.value != "separate"
        ):
            problems.append(
                f"{label}: verifier.environment_mode must be 'separate' — a "
                f"shared verifier grades inside the environment the agent "
                f"controls, and Harbor cannot regrade it (ADR 0004)"
            )

        # `artifacts` is a top-level key. Written after any table header it
        # becomes a member of that table, parses to an empty list without a
        # word, and the separate verifier then receives nothing but the
        # convention default — so the trajectory is unreachable and every
        # judge criterion grades behaviour it cannot see. Caught here because
        # the run itself does not complain.
        if not config.artifacts:
            problems.append(
                f"{label}: no artifacts declared. If task.toml appears to "
                f"declare them, check that `artifacts = [...]` sits above the "
                f"first [table] header — TOML assigns it to the preceding "
                f"table otherwise."
            )
        else:
            declared = {
                entry if isinstance(entry, str) else getattr(entry, "source", "")
                for entry in config.artifacts
            }
            if not any(d.startswith("/logs/agent") for d in declared):
                problems.append(
                    f"{label}: /logs/agent is not collected, so the separate "
                    f"verifier never receives the agent's trajectory "
                    f"(docs/reproducibility.md)"
                )

        metadata = raw.get("metadata", {})
        for field in REQUIRED_METADATA:
            if not metadata.get(field):
                problems.append(f"{label}: metadata.{field} is missing")

        sha = metadata.get("target_sha", "")
        if sha and len(sha) != 40:
            problems.append(
                f"{label}: target_sha must be a full 40-character commit SHA, "
                f"not a branch or a short form; an abbreviated pin can become "
                f"ambiguous as the target repository grows"
            )

        if case_dir.parent.name == "open":
            if (case_dir / "solution").exists():
                problems.append(
                    f"{label}: open cases ship no solution/ (ADR 0003)"
                )
            if not (case_dir / "tests" / "known-concerns.md").exists():
                problems.append(
                    f"{label}: no tests/known-concerns.md; a case with no "
                    f"recorded human baseline cannot be graded for outcome "
                    f"quality"
                )

    if problems:
        print(f"{len(problems)} problem(s) in {checked} case(s):", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        return 1

    print(f"{checked} case(s) valid")
    return 0


if __name__ == "__main__":
    sys.exit(main())
